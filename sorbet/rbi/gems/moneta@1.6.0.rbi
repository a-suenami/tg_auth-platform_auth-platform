# CouchDB backend
#
# You can store hashes directly using this adapter.
#
# @api public
# @example Store hashes
#   db = Moneta::Adapters::Couch.new
#   db['key'] = {a: 1, b: 2}
#
# source://moneta//lib/moneta/adapters/couch.rb#15
class Moneta::Adapters::Couch < ::Moneta::Adapter
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param options [Hash]
  # @return [Couch] a new instance of Couch
  #
  # source://moneta//lib/moneta/adapters/couch.rb#57
  def initialize(options = T.unsafe(nil)); end

  # Clear all keys in this store
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @param options [Hash]
  # @return [void]
  #
  # source://moneta//lib/moneta/adapters/couch.rb#148
  def clear(options = T.unsafe(nil)); end

  # Atomically sets a key to value if it's not set.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param value [Object]
  # @param options [Hash]
  # @return [Boolean] key was set
  #
  # source://moneta//lib/moneta/adapters/couch.rb#179
  def create(key, value, options = T.unsafe(nil)); end

  # Delete the key from the store and return the current value
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Object] current value
  #
  # source://moneta//lib/moneta/adapters/couch.rb#121
  def delete(key, options = T.unsafe(nil)); end

  # Calls block once for each key in store, passing the key as a parameter. If
  # no block is given, an enumerator is returned instead.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @overload each_key
  # @overload each_key
  #
  # source://moneta//lib/moneta/adapters/couch.rb#197
  def each_key; end

  # Exists the value with key
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Boolean]
  #
  # source://moneta//lib/moneta/adapters/couch.rb#79
  def key?(key, options = T.unsafe(nil)); end

  # Fetch value with key. Return nil if the key doesn't exist
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Object] value
  #
  # source://moneta//lib/moneta/adapters/couch.rb#86
  def load(key, options = T.unsafe(nil)); end

  # Stores the pairs in the key-value store, and returns itself. When a block
  # is provided, it will be called before overwriting any existing values with
  # the key, old value and supplied value, and the return value of the block
  # will be used in place of the supplied value.
  #
  # @api public
  # @note Some adapters may implement this method atomically, or in two passes
  #   when a block is provided. The default implmentation uses {#key?},
  #   {#load} and {#store}.
  # @option options
  # @overload merge!
  # @overload merge!
  #
  # source://moneta//lib/moneta/adapters/couch.rb#235
  def merge!(pairs, options = T.unsafe(nil)); end

  # Returns a collection of key-value pairs corresponding to those supplied
  # keys which are present in the key-value store, and their associated
  # values.  Only those keys present in the store will have pairs in the
  # return value.  The return value can be any enumerable object that yields
  # pairs, so it could be a hash, but needn't be.
  #
  # @api public
  # @note The keys in the return value may be the same objects that were
  #   supplied (i.e. {Object#equal?}), or may simply be equal (i.e.
  #   {Object#==}).
  # @note Some adapters may implement this method atomically. The default
  #   implmentation uses {#values_at}.
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param keys [<Object>] The keys for the values to fetch
  # @param options [Hash]
  # @return [<(Object, Object)>] A collection of key-value pairs
  #
  # source://moneta//lib/moneta/adapters/couch.rb#222
  def slice(*keys, **options); end

  # Store value with key
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param value [Object]
  # @param options [Hash]
  # @return value
  #
  # source://moneta//lib/moneta/adapters/couch.rb#101
  def store(key, value, options = T.unsafe(nil)); end

  # Returns an array containing the values associated with the given keys, in
  # the same order as the supplied keys. If a key is not present in the
  # key-value-store, nil is returned in its place.
  #
  # @api public
  # @note Some adapters may implement this method atomically, but the default
  #   implementation simply makes repeated calls to {#load}.
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param keys [<Object>] The keys for the values to fetch
  # @param options [Hash]
  # @return [Array<Object, nil>] Array containing the values requested, with
  #   nil for missing values
  #
  # source://moneta//lib/moneta/adapters/couch.rb#216
  def values_at(*keys, **options); end

  private

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#418
  def all_docs(sorted: T.unsafe(nil), **params); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#281
  def body_to_value(body); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#431
  def bulk_docs(docs, returns: T.unsafe(nil), full_commit: T.unsafe(nil)); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#348
  def cache_response_rev(key, response); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#336
  def cache_revs(*keys); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#315
  def create_db; end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#358
  def delete_cached_rev(key); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#285
  def doc_to_value(doc); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#369
  def encode_query(query); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#277
  def full_commit_header(full_commit); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#400
  def get(key, returns: T.unsafe(nil), **options); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#404
  def head(key, returns: T.unsafe(nil), **options); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#344
  def parse_rev(response); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#413
  def post(key, doc = T.unsafe(nil), returns: T.unsafe(nil), **options); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#408
  def put(key, doc = T.unsafe(nil), returns: T.unsafe(nil), **options); end

  # @api public
  #
  # source://moneta//lib/moneta/adapters/couch.rb#373
  def request(method, key, body = T.unsafe(nil), returns: T.unsafe(nil), cache_rev: T.unsafe(nil), expect: T.unsafe(nil), query: T.unsafe(nil), headers: T.unsafe(nil)); end


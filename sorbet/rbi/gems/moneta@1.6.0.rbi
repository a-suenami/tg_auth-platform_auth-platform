# Proxy base class
#
# @api public
#
# source://moneta//lib/moneta/proxy.rb#4
class Moneta::Proxy
  include ::Moneta::OptionSupport
  include ::Moneta::Defaults
  include ::Moneta::Config
  extend ::Moneta::Defaults::ClassMethods
  extend ::Moneta::Config::ClassMethods

  # @api public
  # @param adapter [Moneta store] underlying adapter
  # @param options [Hash]
  # @return [Proxy] a new instance of Proxy
  #
  # source://moneta//lib/moneta/proxy.rb#12
  def initialize(adapter, options = T.unsafe(nil)); end

  # @api public
  #
  # source://moneta//lib/moneta/proxy.rb#8
  def adapter; end

  # Clear all keys in this store
  #
  # @api public
  # @param options [Hash]
  # @return [void]
  #
  # source://moneta//lib/moneta/proxy.rb#95
  def clear(options = T.unsafe(nil)); end

  # Explicitly close the store
  #
  # @api public
  # @return nil
  #
  # source://moneta//lib/moneta/proxy.rb#43
  def close; end

  # Overrides the default implementation of the config method to:
  #
  # * pass the adapter's config, if this proxy has no configuration of its
  #   own
  # * return a merged configuration, allowing the proxy have precedence over
  #   the adapter
  #
  # @api public
  #
  # source://moneta//lib/moneta/proxy.rb#145
  def config; end

  # Atomically sets a key to value if it's not set.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param value [Object]
  # @param options [Hash]
  # @return [Boolean] key was set
  #
  # source://moneta//lib/moneta/proxy.rb#38
  def create(key, value, options = T.unsafe(nil)); end

  # Delete the key from the store and return the current value
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Object] current value
  #
  # source://moneta//lib/moneta/proxy.rb#86
  def delete(key, options = T.unsafe(nil)); end

  # Calls block once for each key in store, passing the key as a parameter. If
  # no block is given, an enumerator is returned instead.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @overload each_key
  # @overload each_key
  # @raise [NotImplementedError]
  #
  # source://moneta//lib/moneta/proxy.rb#23
  def each_key(&block); end

  # Returns features list
  #
  # @api public
  # @return [Array<Symbol>] list of features
  #
  # source://moneta//lib/moneta/proxy.rb#122
  def features; end

  # Behaves identically to {#values_at} except that it accepts an optional
  # block. When supplied, the block will be called successively with each
  # supplied key that is not present in the store.  The return value of the
  # block call will be used in place of nil in returned the array of values.
  #
  # @api public
  # @note Some adapters may implement this method atomically. The default
  #   implmentation uses {#values_at}.
  # @overload fetch_values
  # @overload fetch_values
  #
  # source://moneta//lib/moneta/proxy.rb#106
  def fetch_values(*keys, **options, &defaults); end

  # Atomically increment integer value with key
  #
  # This method also accepts negative amounts.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @option options
  # @option options
  # @param key [Object]
  # @param amount [Integer]
  # @param options [Hash]
  # @return [Object] value from store
  #
  # source://moneta//lib/moneta/proxy.rb#33
  def increment(key, amount = T.unsafe(nil), options = T.unsafe(nil)); end

  # Exists the value with key
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Boolean]
  #
  # source://moneta//lib/moneta/proxy.rb#18
  def key?(key, options = T.unsafe(nil)); end

  # Fetch value with key. Return nil if the key doesn't exist
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Object] value
  #
  # source://moneta//lib/moneta/proxy.rb#58
  def load(key, options = T.unsafe(nil)); end

  # Stores the pairs in the key-value store, and returns itself. When a block
  # is provided, it will be called before overwriting any existing values with
  # the key, old value and supplied value, and the return value of the block
  # will be used in place of the supplied value.
  #
  # @api public
  # @note Some adapters may implement this method atomically, or in two passes
  #   when a block is provided. The default implmentation uses {#key?},
  #   {#load} and {#store}.
  # @overload merge!
  # @overload merge!
  #
  # source://moneta//lib/moneta/proxy.rb#116
  def merge!(pairs, options = T.unsafe(nil), &block); end

  # Returns a collection of key-value pairs corresponding to those supplied
  # keys which are present in the key-value store, and their associated
  # values.  Only those keys present in the store will have pairs in the
  # return value.  The return value can be any enumerable object that yields
  # pairs, so it could be a hash, but needn't be.
  #
  # @api public
  # @note The keys in the return value may be the same objects that were
  #   supplied (i.e. {Object#equal?}), or may simply be equal (i.e.
  #   {Object#==}).
  # @note Some adapters may implement this method atomically. The default
  #   implmentation uses {#values_at}.
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param keys [<Object>] The keys for the values to fetch
  # @param options [Hash]
  # @return [<(Object, Object)>] A collection of key-value pairs
  #
  # source://moneta//lib/moneta/proxy.rb#111
  def slice(*keys, **options); end

  # Store value with key
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param value [Object]
  # @param options [Hash]
  # @return value
  #
  # source://moneta//lib/moneta/proxy.rb#73
  def store(key, value, options = T.unsafe(nil)); end

  # Returns an array containing the values associated with the given keys, in
  # the same order as the supplied keys. If a key is not present in the
  # key-value-store, nil is returned in its place.
  #
  # @api public
  # @note Some adapters may implement this method atomically, but the default
  #   implementation simply makes repeated calls to {#load}.
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param keys [<Object>] The keys for the values to fetch
  # @param options [Hash]
  # @return [Array<Object, nil>] Array containing the values requested, with
  #   nil for missing values
  #
  # source://moneta//lib/moneta/proxy.rb#101
  def values_at(*keys, **options); end

  class << self
    # @api private
    #
    # source://moneta//lib/moneta/proxy.rb#128
    def features_mask; end

    # Declares that this adapter does not support the given feature, and adds
    # a stub method that raises a NotImplementedError.  Useful when inheriting
    # from another adapter.
    #
    # @api public
    # @example
    #   class MyAdapter < OtherAdapterWithCreate
    #   include Moneta::Defaults
    #   not_supports :create
    #   end
    #
    # source://moneta//lib/moneta/proxy.rb#133
    def not_supports(*features); end
  end
end


  # source://moneta//lib/moneta/shared.rb#46
  def wrap(*args); end
end

# Combines multiple stores. Reads return the result from the first store,
# writes go to all stores.
#
# @api public
# @example Add `Moneta::Stack` to proxy stack
#   Moneta.build do
#   use(:Stack) do
#   add { adapter :Redis }
#   add { adapter :File, dir: 'data' }
#   add { adapter :File, dir: 'replicate' }
#   end
#   end
#
# source://moneta//lib/moneta/stack.rb#15
class Moneta::Stack
  include ::Moneta::OptionSupport
  include ::Moneta::Defaults
  extend ::Moneta::Defaults::ClassMethods

  # @api public
  # @option options
  # @param options [Hash] Options hash
  # @return [Stack] a new instance of Stack
  # @yieldparam Builder block
  #
  # source://moneta//lib/moneta/stack.rb#38
  def initialize(options = T.unsafe(nil), &block); end

  # Clear all keys in this store
  #
  # @api public
  # @param options [Hash]
  # @return [void]
  #
  # source://moneta//lib/moneta/stack.rb#86
  def clear(options = T.unsafe(nil)); end

  # Explicitly close the store
  #
  # @api public
  # @return nil
  #
  # source://moneta//lib/moneta/stack.rb#92
  def close; end

  # Atomically sets a key to value if it's not set.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param value [Object]
  # @param options [Hash]
  # @return [Boolean] key was set
  #
  # source://moneta//lib/moneta/stack.rb#71
  def create(key, value, options = T.unsafe(nil)); end

  # Delete the key from the store and return the current value
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Object] current value
  #
  # source://moneta//lib/moneta/stack.rb#78
  def delete(key, options = T.unsafe(nil)); end

  # Returns features list
  #
  # @api public
  # @return [Array<Symbol>] list of features
  #
  # source://moneta//lib/moneta/stack.rb#98
  def features; end

  # Atomically increment integer value with key
  #
  # This method also accepts negative amounts.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @option options
  # @option options
  # @param key [Object]
  # @param amount [Integer]
  # @param options [Hash]
  # @return [Object] value from store
  #
  # source://moneta//lib/moneta/stack.rb#64
  def increment(key, amount = T.unsafe(nil), options = T.unsafe(nil)); end

  # Exists the value with key
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Boolean]
  #
  # source://moneta//lib/moneta/stack.rb#44
  def key?(key, options = T.unsafe(nil)); end

  # Fetch value with key. Return nil if the key doesn't exist
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param options [Hash]
  # @return [Object] value
  #
  # source://moneta//lib/moneta/stack.rb#49
  def load(key, options = T.unsafe(nil)); end

  # @api public
  #
  # source://moneta//lib/moneta/stack.rb#33
  def stack; end

  # Store value with key
  #
  # @api public
  # @option options
  # @option options
  # @option options
  # @option options
  # @param key [Object]
  # @param value [Object]
  # @param options [Hash]
  # @return value
  #
  # source://moneta//lib/moneta/stack.rb#58
  def store(key, value, options = T.unsafe(nil)); end
end

# @api private
#
# source://moneta//lib/moneta/stack.rb#19
class Moneta::Stack::DSL
  # @api private
  # @return [DSL] a new instance of DSL
  #
  # source://moneta//lib/moneta/stack.rb#20
  def initialize(stack, &block); end

  # @api public
  # @raise [ArgumentError]
  #
  # source://moneta//lib/moneta/stack.rb#26
  def add(store = T.unsafe(nil), &block); end
end

# Base class for {Mutex} and {Semaphore}
#
# @abstract
#
# source://moneta//lib/moneta/synchronize.rb#4
class Moneta::SynchronizePrimitive
  # Enter critical section (blocking)
  #
  # @param timeout [Number] Maximum time to wait
  # @param wait [Number] Sleep time between tries to acquire lock
  # @return [Boolean] true if the lock was aquired
  #
  # source://moneta//lib/moneta/synchronize.rb#31
  def enter(timeout = T.unsafe(nil), wait = T.unsafe(nil)); end

  # Leave critical section
  #
  # source://moneta//lib/moneta/synchronize.rb#42
  def leave; end

  # Enter critical section (blocking)
  #
  # @param timeout [Number] Maximum time to wait
  # @param wait [Number] Sleep time between tries to acquire lock
  # @return [Boolean] true if the lock was aquired
  #
  # source://moneta//lib/moneta/synchronize.rb#39
  def lock(timeout = T.unsafe(nil), wait = T.unsafe(nil)); end

  # Is the lock acquired?
  #
  # @return [Boolean]
  #
  # source://moneta//lib/moneta/synchronize.rb#51
  def locked?; end

  # Synchronize block
  #
  # @api public
  # @return [Object] result of block
  # @yieldparam Synchronized block
  #
  # source://moneta//lib/moneta/synchronize.rb#10
  def synchronize; end

  # Try to enter critical section (nonblocking)
  #
  # @return [Boolean] true if the lock was acquired
  #
  # source://moneta//lib/moneta/synchronize.rb#20
  def try_enter; end

  # Try to enter critical section (nonblocking)
  #
  # @return [Boolean] true if the lock was acquired
  #
  # source://moneta//lib/moneta/synchronize.rb#24
  def try_lock; end

  # Leave critical section
  #
  # source://moneta//lib/moneta/synchronize.rb#48
  def unlock; end
end

# Transforms keys and values (Marshal, YAML, JSON, Base64, MD5, ...).
# You can bypass the transformer (e.g. serialization) by using the `:raw` option.
#
# @api public
# @example Add `Moneta::Transformer` to proxy stack
#   Moneta.build do
#   transformer key: [:marshal, :escape], value: [:marshal]
#   adapter :File, dir: 'data'
#   end
# @example Bypass serialization
#   store.store('key', 'value', raw: true)
#   store['key'] # raises an Exception
#   store.load('key', raw: true) # returns 'value'
#
#   store['key'] = 'value'
#   store.load('key', raw: true) # returns "\x04\bI\"\nvalue\x06:\x06ET"
#
# source://moneta//lib/moneta/transformer.rb#20
class Moneta::Transformer < ::Moneta::Proxy
  class << self
    # @api public
    # @option options
    # @option options
    # @option options
    # @option options
    # @option options
    # @param adapter [Moneta store] The underlying store
    # @param options [Hash]
    # @raise [ArgumentError]
    # @return [Transformer] new Moneta transformer
    #
    # source://moneta//lib/moneta/transformer.rb#32
    def new(adapter, options = T.unsafe(nil)); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#22
    def original_new(*_arg0); end

    private

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#373
    def class_name(keys, values); end

    # @api public
    # @raise [ArgumentError]
    #
    # source://moneta//lib/moneta/transformer.rb#44
    def compile(keys, values); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#85
    def compile_each_key_support_clause(klass, keys); end

    # Compile option initializer
    #
    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#332
    def compile_initializer(type, transformers); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#91
    def compile_key_transformer(klass, key, key_opts, key_load, key_load_opts, key_test, key_test_opts); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#225
    def compile_key_value_transformer(klass, key, key_opts, key_load, key_load_opts, key_test, key_test_opts, load, load_opts, dump, dump_opts); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#379
    def compile_prefix(name:, transformer:, value:); end

    # Returned compiled transformer code string
    #
    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#350
    def compile_transformer(transformer, var, idx = T.unsafe(nil)); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#341
    def compile_validator(str); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#157
    def compile_value_transformer(klass, load, load_opts, dump, dump_opts); end

    # @api public
    #
    # source://moneta//lib/moneta/transformer.rb#80
    def without(*options); end
  end
end

# @api private
#
# source://moneta//lib/moneta/transformer/helper.rb#4
module Moneta::Transformer::Helper
  extend ::Moneta::Transformer::Helper

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#44
  def bunzip2(value); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#36
  def bzip2(value); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#7
  def escape(value); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#20
  def hmacsign(value, secret); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#15
  def hmacverify(value, secret); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#32
  def spread(value); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#24
  def truncate(value, maxlen); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper.rb#11
  def unescape(value); end
end

# @api private
#
# source://moneta//lib/moneta/transformer/helper/bson.rb#5
module Moneta::Transformer::Helper::BSON
  extend ::Moneta::Transformer::Helper::BSON

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper/bson.rb#12
  def dump(value); end

  # @api private
  #
  # source://moneta//lib/moneta/transformer/helper/bson.rb#8
  def load(value); end
end

# Allowed key transformers (Read it like a regular expression!)
#
# source://moneta//lib/moneta/transformer/config.rb#66
Moneta::Transformer::KEY_TRANSFORMER = T.let(T.unsafe(nil), String)

# Key transformers that can be "loaded" (e.g. reversed) and can be used by the key enumeration feature
#
# source://moneta//lib/moneta/transformer/config.rb#69
Moneta::Transformer::LOAD_KEY_TRANSFORMER = T.let(T.unsafe(nil), String)

# Key transformers that can be "tested for success" with a dumped key and can be used by the key enumeration feature
#
# source://moneta//lib/moneta/transformer/config.rb#72
Moneta::Transformer::TEST_KEY_TRANSFORMER = T.let(T.unsafe(nil), String)

# Available key/value transformers
#
# source://moneta//lib/moneta/transformer/config.rb#4
Moneta::Transformer::TRANSFORMER = T.let(T.unsafe(nil), Hash)

# Allowed value transformers (Read it like a regular expression!)
#
# source://moneta//lib/moneta/transformer/config.rb#63
Moneta::Transformer::VALUE_TRANSFORMER = T.let(T.unsafe(nil), String)

# @api private
#
# source://moneta//lib/moneta/utils.rb#3
module Moneta::Utils
  extend ::Moneta::Utils

  # @api private
  #
  # source://moneta//lib/moneta/utils.rb#15
  def only(hash, *keys); end

  # @api private
  #
  # source://moneta//lib/moneta/utils.rb#6
  def without(hash, *keys); end
end

# Adds weak create support to the underlying store
#
# @api public
# @note The create method will not be thread or multi-process safe (this is meant by weak)
#
# source://moneta//lib/moneta/weak.rb#6
class Moneta::WeakCreate < ::Moneta::Proxy
  include ::Moneta::CreateSupport

  # @api public
  # @param adapter [Moneta store] The underlying store
  # @param options [Hash]
  # @return [WeakCreate] a new instance of WeakCreate
  #
  # source://moneta//lib/moneta/weak.rb#11
  def initialize(adapter, options = T.unsafe(nil)); end
end

# Adds weak key enumeration support to the underlying store
#
# @api public
# @note This class wraps methods that store and retrieve entries in order to
#   track which keys are in the store, and uses this list when doing key
#   traversal.  This means that {#each_key each_key} will only yield keys
#   which have been accessed previously via the present store object.  This
#   wrapper is therefore best suited to adapters which are not persistent, and
#   which cannot be shared.
#
# source://moneta//lib/moneta/weak_each_key.rb#14
class Moneta::WeakEachKey < ::Moneta::Wrapper
  # @api public
  # @param adapter [Moneta store] The underlying store
  # @param options [Hash]
  # @return [WeakEachKey] a new instance of WeakEachKey
  #
  # source://moneta//lib/moneta/weak_each_key.rb#19
  def initialize(adapter, options = T.unsafe(nil)); end

  # Calls block once for each key in store, passing the key as a parameter. If
  # no block is given, an enumerator is returned instead.
  #
  # @api public
  # @note Not every Moneta store implements this method,
  #   a NotImplementedError is raised if it is not supported.
  # @overload each_key
  # @overload each_key
  #
  # source://moneta//lib/moneta/weak_each_key.rb#26
  def each_key; end

  protected

  # @api public
  #
  # source://moneta//lib/moneta/weak_each_key.rb#34
  def all_keys; end

  # @api public
  #
  # source://moneta//lib/moneta/weak_each_key.rb#68
  def each_key_save(key); end

  # @api public
  #
  # source://moneta//lib/moneta/weak_each_key.rb#36
  def wrap(name, *args); end
end

# Adds weak increment support to the underlying store
#
# @api public
# @note The increment method will not be thread or multi-process safe (this is meant by weak)

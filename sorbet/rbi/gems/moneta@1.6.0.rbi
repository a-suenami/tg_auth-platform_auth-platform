#   Moneta.build do
#   use :Fallback
#   adapter :Client
#   end
# @example Specifying an exception to rescue
#   Moneta.build do
#   use :Fallback, rescue: Redis::CannotConnectError
#   adapter :Redis
#   end
# @example Specifying a different fallback
#   Moneta.build do
#   use :Fallback do
#   # This is a new builder context
#   adapter :Memory
#   end
#   adapter :File, dir: 'cache'
#   end

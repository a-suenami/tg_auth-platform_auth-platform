# Raised in case Phony can't normalize a given number.
#
# @example
#   Phony.normalize("Fnork!") # Raises a Phony::NormalizationError.
#
# source://phony//lib/phony.rb#84
class Phony::NormalizationError < ::ArgumentError
  # @return [NormalizationError] a new instance of NormalizationError
  #
  # source://phony//lib/phony.rb#85
  def initialize; end
end

# Raised in case Phony can't split a given number.
#
# @example
#   Phony.split("Fnork!") # Raises a Phony::SplittingError.
#
# source://phony//lib/phony.rb#95
class Phony::SplittingError < ::ArgumentError
  # @return [SplittingError] a new instance of SplittingError
  #
  # source://phony//lib/phony.rb#96
  def initialize(number); end
end

# source://phony//lib/phony/trunk_code.rb#3
class Phony::TrunkCode
  # Parameters:
  #  * code: The trunk code, e.g. 0.
  #
  # Options:
  #  * normalize: [true (default), false] Remove the trunk code when normalizing (only use if number scheme is defined unambiguously).
  #  * split: [true, false (default)] Remove the trunk code when splitting (only use if number scheme is defined unambiguously).
  #  * format: [true (default), false] Add the trunk code when formatting (passing `false` will not add it).
  #
  # @return [TrunkCode] a new instance of TrunkCode
  #
  # source://phony//lib/phony/trunk_code.rb#13
  def initialize(code, options = T.unsafe(nil)); end

  # Format the trunk code using the spaces given.
  #
  # source://phony//lib/phony/trunk_code.rb#45
  def format(space, force = T.unsafe(nil)); end

  # Normalize normalizes the given national number.
  #
  # source://phony//lib/phony/trunk_code.rb#38
  def normalize(national_number, options = T.unsafe(nil)); end

  # Split gets a number without country code and splits it into
  # its parts.
  #
  # source://phony//lib/phony/trunk_code.rb#31
  def split(national_number); end

  # Prepends itself to the other codes.
  #
  # source://phony//lib/phony/trunk_code.rb#23
  def |(other); end
end

# Helper module that maps vanity numbers to digit numbers.
#
# source://phony//lib/phony/vanity.rb#5
module Phony::Vanity
  class << self
    # Returns a char to number mapping string for the String#tr method.
    #
    # source://phony//lib/phony/vanity.rb#9
    def mapping; end

    # source://phony//lib/phony/vanity.rb#33
    def normalized(number); end

    # Replaces (and normalizes) vanity characters of passed number with correct digits.
    #
    # source://phony//lib/phony/vanity.rb#18
    def replace(number); end

    # @return [Boolean]
    #
    # source://phony//lib/phony/vanity.rb#26
    def vanity?(number); end
  end
end

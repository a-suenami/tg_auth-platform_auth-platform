  def length; end

  # Returns the value of attribute on_fail_take.
  #
  # source://phony//lib/phony/national_splitters/regex.rb#14
  def on_fail_take; end

  # Returns the value of attribute regex.
  #
  # source://phony//lib/phony/national_splitters/regex.rb#14
  def regex; end

  # Split a local number according to an assumed country specific format.
  #
  # Examples
  # * split '3643533' # => ['364', '35', '33'] # (Switzerland)
  #
  # source://phony//lib/phony/national_splitters/regex.rb#35
  def split(national_number); end

  class << self
    # Get a splitter for the given format.

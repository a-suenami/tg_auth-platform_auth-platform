  # source://phony//lib/phony/local_splitters/fixed.rb#64
  def plausible?(rest, hints = T.unsafe(nil)); end

  # Split a local number according to an assumed country specific format.
  #
  # Examples
  # * split '3643533' # => ['364', '35', '33'] # (Switzerland)
  #
  # source://phony//lib/phony/local_splitters/fixed.rb#54
  def split(number); end

  class << self
    # Get a splitter for the given format.
    #
    # Caches the created splitter for the given format.
    #
    # source://phony//lib/phony/local_splitters/fixed.rb#21
    def instance_for(format = T.unsafe(nil)); end
  end
end

# Local splitter class to split the last part of
# a number, i.e. minus cc or ndc.
#
# Countries can create new instances according to their needs.
#
# Note: Countries should use instance_for
#       to avoid getting new local splitter instances.
#
# source://phony//lib/phony/local_splitters/regex.rb#13
class Phony::LocalSplitters::Regex
  # Initialize with a regex => format mapping.
  #
  # @return [Regex] a new instance of Regex
  #
  # source://phony//lib/phony/local_splitters/regex.rb#27
  def initialize(mapping); end

  # Returns the value of attribute fallback.
  #
  # source://phony//lib/phony/local_splitters/regex.rb#15
  def fallback; end

  # Returns the value of attribute mapping.
  #
  # source://phony//lib/phony/local_splitters/regex.rb#15
  def mapping; end

  # @return [Boolean]
  #
  # source://phony//lib/phony/local_splitters/regex.rb#45
  def plausible?(rest, hints = T.unsafe(nil)); end

  # Split a local number according to an assumed country specific format.
  #
  # Examples
  # * split '3643533' # => ['364', '35', '33'] # (Switzerland)
  #
  # source://phony//lib/phony/local_splitters/regex.rb#37
  def split(number); end

  private

  # @return [Boolean]
  #
  # source://phony//lib/phony/local_splitters/regex.rb#64
  def plausible_with?(number, format); end

  # source://phony//lib/phony/local_splitters/regex.rb#56
  def split_with(number, format); end

  class << self
    # Get a splitter for the given format.
    #
    # Note: Not cached.
    #
    # source://phony//lib/phony/local_splitters/regex.rb#21
    def instance_for(mapping); end
  end
end

# NationalCodes have a special numbers splitter, a national code splitter and a local code splitter.
#
# source://phony//lib/phony/national_code.rb#5
class Phony::NationalCode
  # @return [NationalCode] a new instance of NationalCode
  #
  # source://phony//lib/phony/national_code.rb#11
  def initialize(national_splitter, local_splitter); end

  # Returns the value of attribute local_splitter.
  #
  # source://phony//lib/phony/national_code.rb#7
  def local_splitter; end

  # Split gets a number without country code and removes a relative zero.
  #
  # Note: Some cases, like Italy, don't remove the relative zero.
  #
  # source://phony//lib/phony/national_code.rb#29
  def normalize(national_number, options = T.unsafe(nil)); end

  # Split gets a number without country code and splits it into
  # its parts.
  #
  # source://phony//lib/phony/national_code.rb#19
  def split(national_number); end
end

# source://phony//lib/phony/national_splitters/dsl.rb#3
module Phony::NationalSplitters; end

# TODO
#
# source://phony//lib/phony/national_splitters/dsl.rb#7
class Phony::NationalSplitters::DSL
  # source://phony//lib/phony/national_splitters/dsl.rb#11
  def >>(local_splitter); end

  # source://phony//lib/phony/national_splitters/dsl.rb#17
  def country_for(local_splitter); end

  # TODO Remove?
  #
  # source://phony//lib/phony/national_splitters/dsl.rb#23
  def reserved; end
end

# TODO Default = Fixed.new(...)?
#
# source://phony//lib/phony/national_splitters/default.rb#7
class Phony::NationalSplitters::Default < ::Phony::NationalSplitters::DSL
  # A valid length (at least 3).
  #
  # source://phony//lib/phony/national_splitters/default.rb#43
  def length; end

  # By default, the national part of a number is always plausible.
  #
  # @example Split the national part of a Swiss number.
  #   Phony.plausible?("1234567") # => true
  # @param rest [String] An national part of a number (ignored).
  # @param size [Fixnum] Size (ignored).
  # @param hints [Hash] Hints (ignored).
  # @return [Boolean] Always true.
  #
  # source://phony//lib/phony/national_splitters/default.rb#37
  def plausible?(rest, size, hints = T.unsafe(nil)); end

  # "Splits" the national part of a phone number into a single piece.
  #
  # @example Split the national part of a Swiss number.
  #   Phony.split("1234567") # => ["1234567"]
  # @param national_number [String] An national part of a number.
  # @return [Array<String>] An Array with the given number part as its element.
  #
  # source://phony//lib/phony/national_splitters/default.rb#22
  def split(national_number); end

  class << self
    # source://phony//lib/phony/national_splitters/default.rb#9
    def instance_for; end
  end
end

# TODO
#
# source://phony//lib/phony/national_splitters/fixed.rb#7
class Phony::NationalSplitters::Fixed < ::Phony::NationalSplitters::DSL
  # @return [Fixed] a new instance of Fixed
  #
  # source://phony//lib/phony/national_splitters/fixed.rb#21
  def initialize(size, options = T.unsafe(nil)); end

  # A valid length.
  #
  # source://phony//lib/phony/national_splitters/fixed.rb#35
  def length; end

  # Sets the attribute special_splitter
  #
  # @param value the value to set the attribute special_splitter to.
  #
  # source://phony//lib/phony/national_splitters/fixed.rb#9
  def special_splitter=(_arg0); end

  # Takes a national number and splits it into ndc and rest.
  #
  # source://phony//lib/phony/national_splitters/fixed.rb#28
  def split(national_number); end

  class << self
    # Get a splitter for the given format.
    #
    # Caches the created splitter for the given format.
    #
    # source://phony//lib/phony/national_splitters/fixed.rb#17
    def instance_for(*parameters); end
  end
end

# This is a national splitter for countries
# which have no NDC / Area Code.
#
# source://phony//lib/phony/national_splitters/none.rb#8
class Phony::NationalSplitters::None < ::Phony::NationalSplitters::Default
  # A valid length.
  #
  # source://phony//lib/phony/national_splitters/none.rb#42
  def length; end

  # On false:
  #
  # This is a hack to make phony's
  # plausible method work even with
  # this splitter.
  #
  # Promise: We will rewrite this soon
  # to beautify, but making it work for
  # people in production is most important
  # right now.
  #
  # The problem is that the validation looks
  # at whether there is a NDC - if it is nil,
  # it is not plausible.
  # (Does not work with this class, of course
  # since using nil is dangerous and breaks
  # abstraction)
  #
  # Note: Decided it stays in. When formatting, it's turned into nil.
  #
  # source://phony//lib/phony/national_splitters/none.rb#36
  def split(national_number); end

  class << self
    # Get a splitter. Caches.
    #
    # source://phony//lib/phony/national_splitters/none.rb#12
    def instance_for(*_arg0); end
  end
end

# National splitter class to split the ndc-local part of a number.
#
# Countries can create new instances according to their needs.
#
# Note: Countries should use instance_for
#       to avoid getting new local splitter instances.
#
# source://phony//lib/phony/national_splitters/regex.rb#12
class Phony::NationalSplitters::Regex < ::Phony::NationalSplitters::Fixed
  # @return [Regex] a new instance of Regex
  #

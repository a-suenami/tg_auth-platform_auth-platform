  # extensions are only supported by PostgreSQL
  #
  # source://activerecord/7.0.4.2/lib/active_record/schema_dumper.rb#99
  def extensions(stream); end

  # source://activerecord/7.0.4.2/lib/active_record/schema_dumper.rb#276

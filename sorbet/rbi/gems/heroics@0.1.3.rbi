#
# source://heroics//lib/heroics/schema.rb#51
class Heroics::ResourceSchema
  # Instantiate a resource schema.
  #
  # @param schema [Hash] The bare JSON schema to wrap.
  # @param name [String] The name of the resource to identify in the schema.
  # @return [ResourceSchema] a new instance of ResourceSchema
  #
  # source://heroics//lib/heroics/schema.rb#58
  def initialize(schema, name); end

  # A description of the resource.
  #
  # source://heroics//lib/heroics/schema.rb#79
  def description; end

  # Get a schema for a named link.
  #
  # @param name [String] The name of the link.
  # @raise [SchemaError] Raised if an unknown link name is provided.
  #
  # source://heroics//lib/heroics/schema.rb#87
  def link(name); end

  # The link schema children that are part of this resource schema.
  #
  # @return [Array<LinkSchema>] The link schema children.
  #
  # source://heroics//lib/heroics/schema.rb#96
  def links; end

  # Returns the value of attribute name.
  #
  # source://heroics//lib/heroics/schema.rb#52
  def name; end
end

# A wrapper around a bare JSON schema to make it easier to use.
#
# source://heroics//lib/heroics/schema.rb#4
class Heroics::Schema
  # Instantiate a schema.
  #
  # @param schema [Hash] The bare JSON schema to wrap.
  # @return [Schema] a new instance of Schema
  #
  # source://heroics//lib/heroics/schema.rb#10
  def initialize(schema); end

  # A description of the API.
  #
  # source://heroics//lib/heroics/schema.rb#19
  def description; end

  # Get a simple human-readable representation of this client instance.
  #
  # source://heroics//lib/heroics/schema.rb#43
  def inspect; end

  # Get a schema for a named resource.
  #
  # @param name [String] The name of the resource.
  # @raise [SchemaError] Raised if an unknown resource name is provided.
  #
  # source://heroics//lib/heroics/schema.rb#27
  def resource(name); end

  # The resource schema children that are part of this schema.
  #
  # @return [Array<ResourceSchema>] The resource schema children.
  #
  # source://heroics//lib/heroics/schema.rb#38
  def resources; end

  # Returns the value of attribute schema.
  #
  # source://heroics//lib/heroics/schema.rb#5
  def schema; end

  # Get a simple human-readable representation of this client instance.
  #
  # source://heroics//lib/heroics/schema.rb#46
  def to_s; end
end

# Raised when a schema has an error that prevents it from being parsed
# correctly.
#
# source://heroics//lib/heroics/errors.rb#5
class Heroics::SchemaError < ::StandardError; end

# source://heroics//lib/heroics/version.rb#3
Heroics::VERSION = T.let(T.unsafe(nil), String)

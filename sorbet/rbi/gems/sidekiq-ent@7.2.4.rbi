# source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#8
class Sidekiq::Limiter::Bucket < ::Sidekiq::Limiter::Base
  # Create a rate limiter of +size+ per +interval+, e.g. 5 per second.
  #
  # Resets at the start of each interval so it's possible to perform
  # more than +size+ operations in a given interval, e.g. you can perform 5
  # operations at 12:03:58.999 and then another 5 operations at 12:03:59.001
  # since the interval resets at 12:03:59.000.
  #
  # Name should be a URL-safe descriptor, i.e. "user_12345", not "Bob's Rate".
  #
  # @raise [ArgumentError]
  # @return [Bucket] a new instance of Bucket
  #
  # source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#23
  def initialize(name, size, interval, options); end

  # Returns the value of attribute size.
  # deprecated
  #
  # source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#11
  def count; end

  # source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#31
  def establish; end

  # Returns the value of attribute interval.
  #
  # source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#11
  def interval; end

  # source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#45
  def key; end

  # Returns the value of attribute size.
  #
  # source://sidekiq-ent//lib/sidekiq-ent/limiter/bucket.rb#11
  def size; end

  # Yield if the current interval has not gone over limit.
  # :used is the number of points used by this call, defaulting to 1.
  #

  # source://sidekiq-ent//lib/sidekiq-ent/hserver.rb#118
  def http_resp(status_code, status_message = T.unsafe(nil), header = T.unsafe(nil), body = T.unsafe(nil)); end

  # Handles the HTTP request and writes the response back to the client, +io+.
  #
  # If an Exception is raised while handling the request, the client will receive
  # a 500 "Internal Server Error" message.
  #
  # source://sidekiq-ent//lib/sidekiq-ent/hserver.rb#133
  def serve(io); end
end


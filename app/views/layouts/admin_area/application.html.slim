doctype html
html lang='ja'
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width,initial-scale=1.0,user-scalable=no'
    meta http-equiv='content-language' content='ja'
    / title = Tenant.current.name
    title = "Tenant.current.name"
    / link rel='icon' href=vite_asset_path('images/admin_area/favicon.svg')
    = vite_client_tag
    = vite_typescript_tag 'entrypoints/admin_area/application'
    = csrf_meta_tags
  body
    = render 'layouts/admin_area/flash'
    nav.uk-navbar-container#main-navbar
      .uk-container.uk-container-expand
        div.tg-application-header uk-navbar="mode: click"
          / div.uk-navbar-left.tg-application-navbar(class="uk-visible@s")
            / = link_to admin_area_root_path, class: 'uk-navbar-item uk-logo'
              / = vite_image_tag 'images/admin_area/triple-logo.svg', width: '120px'

          div.uk-navbar-left.tg-application-navbar.content-navbar(class="uk-visible@s")
            ul.uk-navbar-nav.uk-hidden-small
              = render 'layouts/admin_area/nav-content'

          div.uk-navbar-right.tg-application-navbar.management-navbar
            ul.uk-navbar-nav
              li
                a href="#" アカウント
                div.uk-navbar-dropdown
                  ul.uk-nav.uk-navbar-dropdown-nav
                    li
                      = link_to 'ログアウト', admin_area_logout_path


    .uk-container.uk-container-expand
      = yield

    #offcanvas-sidebar uk-offcanvas=""
      .uk-offcanvas-bar
        button.uk-offcanvas-close type='button' uk-close=''

doctype html
html lang='ja'
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width,initial-scale=1.0,user-scalable=no'
    meta http-equiv='content-language' content='ja'
    / title = Tenant.current.name
    title = "Tenant.current.name"
    / link rel='icon' href=vite_asset_path('images/ruler_area/favicon.svg')
    = vite_client_tag
    = vite_typescript_tag 'entrypoints/ruler_area/application'
    = csrf_meta_tags
  body.l-page
    .l-page-sidebar
        .uk-width-medium.uk-height-1-1.uk-section-secondary
          .uk-container.uk-height-1-1
            h3.uk-padding.uk-padding-remove-horizontal Ruler管理画面
            .tg-sidebar-section
              ul.uk-nav.uk-nav-default
                ul.uk-parent
                  = link_to 'テナント一覧', ruler_area_tenants_path
                  / ul.uk-nav-sub
                  /   li
                  /     = link_to 'テナント一覧', ruler_area_tenants_path
            .tg-sidebar-section
              - if @tenant_id.present?
                ul.uk-nav.uk-nav-default
                  ul.uk-parent
                    = link_to 'Login Spa Application', ruler_area_tenant_login_spa_applications_path(@tenant_id)

            .tg-sidebar-section.bottom
              ul.uk-nav.uk-nav-default
                li アカウント
                li = @current_ruler&.email
                li = link_to 'ログアウト', ruler_area_logout_path

    .l-page-contents
      = render 'layouts/ruler_area/flash'
      = yield

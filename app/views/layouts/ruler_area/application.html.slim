doctype html
html lang='ja'
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width,initial-scale=1.0,user-scalable=no'
    meta http-equiv='content-language' content='ja'
    title System Preferences
    link rel='icon' href=vite_asset_path('images/ruler_area/favicon.svg')
    = vite_client_tag
    = vite_typescript_tag 'entrypoints/ruler_area/application'
    = csrf_meta_tags
  body
    = render 'layouts/ruler_area/flash'
    div.uk-navbar-container.rl-navbar-container uk-sticky=''
      .uk-container.uk-container-expand
        nav.uk-navbar
          .uk-navbar-left
            ul.uk-navbar-nav
              a.uk-navbar-item.uk-logo
                | System Preferences
          .uk-navbar-right
            ul.uk-navbar-nav class='uk-visible@m'
            a.uk-navbar-toggle.uk-icon.uk-navbar-toggle-icon aria-expanded='false' class='uk-hidden@m' href='#offcanvas' uk-navbar-toggle-icon='' uk-toggle='target: #offcanvas-sidebar'
    .rl-body
        ul.uk-nav.uk-nav-default.rl-nav
          li.uk-nav-header Tenant Settings
          li.uk-nav-divider
          li
            /= link_to 'AppConstants', ruler_area_app_constants_path
        ul.uk-nav.uk-nav-default.uk-margin-top.rl-nav
          li.uk-nav-header System
          li.uk-nav-divider
          li
            /= link_to 'Tenants', ruler_area_tenants_path
          li
            /= link_to 'System accounts', ruler_area_rulers_path
      .rl-main.uk-section.uk-section-default
        = yield

    #offcanvas-sidebar uk-offcanvas=""
      .uk-offcanvas-bar
        button.uk-offcanvas-close type='button' uk-close=''

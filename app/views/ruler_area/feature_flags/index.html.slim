ul.uk-breadcrumb
  li
    span Feature Flags

.am-page-header
  h3 Feature Flags 管理

/ Tenant Settings Section
.uk-margin-top
  .uk-card.uk-card-default.uk-card-body
    h4.uk-card-title
      span.uk-margin-small-right uk-icon="users"
      | テナント別設定
    p.uk-text-muted.uk-text-small
      | 各テナントごとに機能の有効/無効を切り替えられます。

    table.uk-table.uk-table-divider.uk-table-hover
      thead
        tr
          th Feature
          - @tenants.each do |tenant|
            th.uk-text-center = tenant.name
          th.uk-text-center Global
      tbody
        - @features.each do |feature|
          - status = @feature_status[feature]
          tr
            td
              strong = feature
            - @tenants.each do |tenant|
              td.uk-text-center
                - enabled = status[:tenant_status][tenant.id]
                = form_with url: toggle_ruler_area_feature_flags_path, method: :post, local: true, data: { turbo: false } do |f|
                  = f.hidden_field :feature, value: feature
                  = f.hidden_field :tenant_id, value: tenant.id
                  = f.hidden_field :enable, value: !enabled
                  = f.check_box :checked, { checked: enabled, class: 'uk-checkbox', onchange: 'this.form.submit()' }, true, false
            td.uk-text-center
              - global_enabled = status[:global_on]
              = form_with url: toggle_ruler_area_feature_flags_path, method: :post, local: true, data: { turbo: false } do |f|
                = f.hidden_field :feature, value: feature
                = f.hidden_field :global, value: true
                = f.hidden_field :enable, value: !global_enabled
                = f.check_box :checked, { checked: global_enabled, class: 'uk-checkbox', onchange: 'this.form.submit()' }, true, false

/ Flipper UI Link
.uk-margin-top
  .uk-card.uk-card-default.uk-card-body
    h4.uk-card-title
      span.uk-margin-small-right uk-icon="cog"
      | Flipper UI
    p.uk-text-muted.uk-text-small
      | より詳細な設定（パーセンテージロールアウト、グローバル有効化など）は Flipper UI で行えます。
    = link_to 'Flipper UI を開く', ruler_area_flipper_path, class: 'uk-button uk-button-default', target: '_blank'


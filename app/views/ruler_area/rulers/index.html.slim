.uk-margin-top.uk-container
  h2 Ruler一覧

  .uk-margin-top.uk-card.uk-card-default.uk-card-body
    .uk-flex.uk-flex-right
      = link_to "新規登録", new_ruler_area_ruler_path, class: "uk-button uk-button-primary"
    - if @rulers.empty?
      p.uk-text-lead
        | No rulers found
    - else
      table.uk-table.uk-table-divider
        tr
          th = Ruler.human_attribute_name(:id)
          th = Ruler.human_attribute_name(:email)
          th = Ruler.human_attribute_name(:name)
          th = Ruler.human_attribute_name(:uid)
          th 削除
        - @rulers.each do |ruler|
          tr
            td
              = ruler.id
            td
              = ruler.email
            td
              = ruler.name
            td
              = ruler.uid
            td
              = link_to '削除', ruler_area_ruler_path(ruler), data: { turbo_method: :delete }, class: 'uk-button uk-button-small uk-button-danger'
    == pagy_nav(@pagy)

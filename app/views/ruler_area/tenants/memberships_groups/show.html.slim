.uk-margin-top.uk-container
  nav.uk-breadcrumb aria-label="Breadcrumb"
    li
      = link_to "テナント一覧", ruler_area_tenants_path
    li
      = link_to @tenant.name, ruler_area_tenant_root_path(@tenant)
    li
      = link_to "メンバーシップ管理", top_ruler_area_tenant_memberships_path(@tenant)
    li
      = link_to "メンバーシップグループ一覧", ruler_area_tenant_memberships_groups_path(@tenant)
    li
      span = @membership_group.display_name

  h2 メンバーシップグループ詳細

  .uk-margin-top.uk-card.uk-card-default.uk-card-body
    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong = Memberships::Group.human_attribute_name(:name)
      .uk-width-2-3
        = @membership_group.name

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong = Memberships::Group.human_attribute_name(:display_name)
      .uk-width-2-3
        = @membership_group.display_name

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong = Memberships::Group.human_attribute_name(:position)
      .uk-width-2-3
        = @membership_group.position

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong 作成日時
      .uk-width-2-3
        = @membership_group.created_at.strftime("%Y年%m月%d日 %H:%M")

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong 更新日時
      .uk-width-2-3
        = @membership_group.updated_at.strftime("%Y年%m月%d日 %H:%M")

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong 紐づいているメンバーシップ
      .uk-width-2-3
        - if @membership_group.memberships.any?
          - @membership_group.memberships.order(:position).each do |membership|
            span.uk-badge.uk-margin-small-right
              = membership.display_name
        - else
          span.uk-text-muted 紐づいているメンバーシップはありません

    .uk-margin-top
      = link_to "メンバーシップを紐づける", assign_memberships_ruler_area_tenant_memberships_group_path(@tenant_id, @membership_group), class: "uk-button uk-button-primary uk-margin-right"
      = link_to "編集", edit_ruler_area_tenant_memberships_group_path(@tenant_id, @membership_group), class: "uk-button uk-button-primary uk-margin-right"
      = link_to "一覧に戻る", ruler_area_tenant_memberships_groups_path(@tenant_id), class: "uk-button uk-button-secondary uk-margin-right"

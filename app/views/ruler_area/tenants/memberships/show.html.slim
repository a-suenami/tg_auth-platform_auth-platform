.uk-margin-top.uk-container
  nav.uk-breadcrumb aria-label="Breadcrumb"
    li
      = link_to "テナント一覧", ruler_area_tenants_path
    li
      = link_to @tenant.name, ruler_area_tenant_root_path(@tenant)
    li
      = link_to "メンバーシップ管理", top_ruler_area_tenant_memberships_path(@tenant)
    li
      = link_to "メンバーシップ一覧", ruler_area_tenant_memberships_path(@tenant)
    li
      span = @membership.display_name

  h2 メンバーシップ詳細

  .uk-margin-top.uk-card.uk-card-default.uk-card-body
    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong = Membership.human_attribute_name(:name)
      .uk-width-2-3
        = @membership.name

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong = Membership.human_attribute_name(:display_name)
      .uk-width-2-3
        = @membership.display_name

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong = Membership.human_attribute_name(:position)
      .uk-width-2-3
        = @membership.position

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong 作成日時
      .uk-width-2-3
        = @membership.created_at.strftime("%Y年%m月%d日 %H:%M")

    .uk-grid.uk-grid-small
      .uk-width-1-3
        strong 更新日時
      .uk-width-2-3
        = @membership.updated_at.strftime("%Y年%m月%d日 %H:%M")

    .uk-margin-top
      = link_to "編集", edit_ruler_area_tenant_membership_path(@tenant_id, @membership), class: "uk-button uk-button-primary uk-margin-right"
      = link_to "一覧に戻る", ruler_area_tenant_memberships_path(@tenant_id), class: "uk-button uk-button-secondary"

  .uk-flex.uk-flex-right
    = link_to "メンバーシップグループ", ruler_area_tenant_membership_path(@tenant_id), class: "uk-button uk-button-secondary uk-margin-right"
    .uk-margin-left
    = link_to "削除", ruler_area_tenant_membership_path(@tenant_id, @membership), data: { turbo_method: :delete, turbo_confirm: "一度削除したデータを戻せません。本当に削除しますか？" }, class: 'uk-button uk-button-danger'

.uk-margin-top.uk-container
  h2 Shopify Multipass 設定 詳細

  .uk-flex.uk-flex-right
    = link_to "編集", edit_ruler_area_tenant_shopify_multipass_setting_path(@tenant_id, @multipass_setting), class: "uk-button uk-button-primary"
    .uk-margin-left
    = link_to "削除", ruler_area_tenant_shopify_multipass_setting_path(@tenant_id, @multipass_setting), data: { turbo_method: :delete, turbo_confirm: "一度削除したデータを戻せません。本当に削除しますか？" }, class: 'uk-button uk-button-danger'

  table.uk-table
    tr
      th = TenantSetting.human_attribute_name(:id)
      td
        = @multipass_setting.id
    tr
      th = TenantSetting.human_attribute_name(:store_url)
      td
        = @multipass_setting.store_url
    tr
      th = TenantSetting.human_attribute_name(:store_name)
      td
        = @multipass_setting.store_name
    tr
      th = TenantSetting.human_attribute_name(:api_key)
      td
        = @multipass_setting.api_key
    tr
      th = TenantSetting.human_attribute_name(:oauth_client_id)
      td
        = @multipass_setting.oauth_client_id
    tr
      th = TenantSetting.human_attribute_name(:scopes)
      td
        = @multipass_setting.scopes
    tr
      th = TenantSetting.human_attribute_name(:multipass_secret)
      td
        = @multipass_setting.multipass_secret
    tr
      th = TenantSetting.human_attribute_name(:webhook_token)
      td
        = @multipass_setting.webhook_token
    tr
      th = TenantSetting.human_attribute_name(:created_at)
      td
        = @multipass_setting.created_at
    tr
      th = TenantSetting.human_attribute_name(:updated_at)
      td
        = @multipass_setting.updated_at

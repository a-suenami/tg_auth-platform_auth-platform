- if membership_plan.errors.any?
  .uk-alert.uk-alert-danger
    h3 = "#{pluralize(membership_plan.errors.count, "error")} prohibited this membership_plan from being saved:"
    ul
      - membership_plan.errors.full_messages.each do |message|
        li = message

.uk-margin
  = f.label :name, class: "uk-form-label"
  .uk-form-controls
    = f.text_field :name, class: "uk-input"

.uk-margin
  = f.label :recurrence, class: "uk-form-label"
  .uk-form-controls
    .uk-form-controls-text
      = f.check_box :recurrence, class: "uk-checkbox"
      = f.label :recurrence, "定期課金（サブスクリプション）", class: "uk-form-label uk-margin-small-left"

.uk-margin
  = f.label :billing_cycle_months, class: "uk-form-label"
  .uk-form-controls
    = f.number_field :billing_cycle_months, min: 1, class: "uk-input"
    .uk-text-small.uk-text-muted 課金サイクル（月単位）。例: 1=月額, 6=半年, 12=年額

.uk-margin
  = f.label :billing_anchor, class: "uk-form-label"
  .uk-form-controls
    = f.select :billing_anchor, options_for_select([['登録日基準', 'by_start_day'], ['毎月の特定日', 'by_fixed_month_day']], membership_plan.billing_anchor), { prompt: '選択してください' }, class: "uk-select"

.uk-margin
  = f.label :anchor_day_of_month, class: "uk-form-label"
  .uk-form-controls
    = f.number_field :anchor_day_of_month, min: 1, max: 31, class: "uk-input"
    .uk-text-small.uk-text-muted 締め日（1-31）。月末指定時は31を入力してください。by_fixed_month_day時のみ使用されます。

.uk-margin
  = f.label :amount, class: "uk-form-label"
  .uk-form-controls
    = f.number_field :amount, class: "uk-input"

.uk-margin
  = f.label :trial_period_days, class: "uk-form-label"
  .uk-form-controls
    = f.number_field :trial_period_days, min: 0, class: "uk-input"
    .uk-text-small.uk-text-muted トライアル期間（日数）。0の場合はトライアルなし。

.uk-margin
  = f.label :position, class: "uk-form-label"
  .uk-form-controls
    = f.number_field :position, min: 0, class: "uk-input"
    .uk-text-small.uk-text-muted 表示順序（数値が小さいほど上位に表示）

.uk-margin
  = f.label :enabled_at, class: "uk-form-label"
  .uk-form-controls
    = f.datetime_local_field :enabled_at, class: "uk-input"

.uk-margin
  = f.label :disabled_at, class: "uk-form-label"
  .uk-form-controls
    = f.datetime_local_field :disabled_at, class: "uk-input"

h3.uk-margin-top メンバーシップ
.uk-margin
  = f.fields_for :plan_components do |component_form|
    .uk-margin-small
      = component_form.hidden_field :tenant_id, value: @tenant_id
      = component_form.select :membership_id, options_from_collection_for_select(Membership.where(tenant_id: @tenant_id), :id, :display_name, component_form.object.membership_id), { prompt: 'メンバーシップを選択' }, class: "uk-select"
      = component_form.hidden_field :_destroy
      = link_to "削除", "#", class: "uk-button uk-button-danger uk-button-small uk-margin-left", onclick: "this.previousElementSibling.value = '1'; this.parentElement.style.display = 'none'; return false;"

.uk-margin#component_container
.uk-margin
  = link_to "メンバーシップを追加", "#", class: "uk-button uk-button-secondary", onclick: "addComponent(); return false;"

h3.uk-margin-top 決済方法
.uk-margin
  = f.fields_for :plan_payment_methods do |payment_method_form|
    .uk-margin-small
      = payment_method_form.select :payment_type, options_for_select([['クレジットカード', 'credit_card'], ['コンビニ決済', 'convenience'], ['キャンペーンコード', 'campaign_code'], ['外部連携', 'external_linkage']], payment_method_form.object.payment_type), { prompt: '決済方法を選択' }, class: "uk-select"
      - if payment_method_form.object.payment_type == 'credit_card'
        .uk-margin-small-top
          = payment_method_form.select :stripe_record_price_id, options_from_collection_for_select(StripeRecord::Price.where(tenant_id: @tenant_id, deleted: false), :id, :name, payment_method_form.object.stripe_record_price_id), { prompt: 'Stripe価格を選択' }, class: "uk-select"
      = payment_method_form.hidden_field :_destroy
      = link_to "削除", "#", class: "uk-button uk-button-danger uk-button-small uk-margin-left", onclick: "this.previousElementSibling.value = '1'; this.parentElement.style.display = 'none'; return false;"

.uk-margin#payment_method_container
.uk-margin
  = link_to "決済方法を追加", "#", class: "uk-button uk-button-secondary", onclick: "addPaymentMethod(); return false;"

.uk-margin-top
  = f.submit class: "uk-button uk-button-primary"
  = link_to "キャンセル", ruler_area_tenant_memberships_plans_path(@tenant_id), class: "uk-button uk-button-secondary uk-margin-left"

javascript:
  function addComponent() {
    var container = document.querySelector('#component_container');
    var newField = document.createElement('div');
    newField.className = 'uk-margin-small';
    newField.innerHTML = `
      <input type="hidden" name="memberships_plan[plan_components_attributes][][tenant_id]" value="#{@tenant_id}">
      <select name="memberships_plan[plan_components_attributes][][membership_id]" class="uk-select">
        <option value="">メンバーシップを選択</option>
        #{options_from_collection_for_select(Membership.where(tenant_id: @tenant_id), :id, :display_name)}
      </select>
      <input type="hidden" name="memberships_plan[plan_components_attributes][][_destroy]" value="0">
      <a href="#" class="uk-button uk-button-danger uk-button-small uk-margin-left" onclick="this.previousElementSibling.value = '1'; this.parentElement.style.display = 'none'; return false;">削除</a>
    `;
    container.appendChild(newField);
  }

  function addPaymentMethod() {
    var container = document.querySelector('#payment_method_container');
    var newField = document.createElement('div');
    newField.className = 'uk-margin-small';
    newField.innerHTML = `
      <select name="memberships_plan[plan_payment_methods_attributes][][payment_type]" class="uk-select" onchange="toggleStripePriceField(this)">
        <option value="">決済方法を選択</option>
        <option value="credit_card">クレジットカード</option>
        <option value="convenience">コンビニ決済</option>
        <option value="campaign_code">キャンペーンコード</option>
        <option value="external_linkage">外部連携</option>
      </select>
      <div class="uk-margin-small-top" id="stripe_price_field" style="display: none;">
        <select name="memberships_plan[plan_payment_methods_attributes][][stripe_record_price_id]" class="uk-select">
          <option value="">Stripe価格を選択</option>
          #{options_from_collection_for_select(StripeRecord::Price.where(tenant_id: @tenant_id, deleted: false), :id, :name)}
        </select>
      </div>
      <input type="hidden" name="memberships_plan[plan_payment_methods_attributes][][_destroy]" value="0">
      <a href="#" class="uk-button uk-button-danger uk-button-small uk-margin-left" onclick="this.previousElementSibling.value = '1'; this.parentElement.style.display = 'none'; return false;">削除</a>
    `;
    container.appendChild(newField);
  }

  function toggleStripePriceField(selectElement) {
    var stripePriceField = selectElement.parentElement.querySelector('#stripe_price_field');
    if (selectElement.value === 'credit_card') {
      stripePriceField.style.display = 'block';
    } else {
      stripePriceField.style.display = 'none';
    }
  }

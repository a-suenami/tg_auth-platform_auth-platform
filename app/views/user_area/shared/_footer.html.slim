footer.ua-footer
  - if @design_settings&.footer_links.present?
    .ua-footer__links
      - @design_settings.footer_links.each do |link|
        = link_to link['text'], link['url'], class: 'ua-footer__link'

  - if @design_settings&.footer_sub_links.present?
    .ua-footer__sub-links.uk-margin-top
      - @design_settings.footer_sub_links.each do |link|
        = link_to link['text'], link['url'], class: 'ua-link uk-margin-small-right'

  .ua-footer__copyright.uk-margin-top
    = "&copy; #{Time.current.year} All Rights Reserved.".html_safe

.l-page
  .uk-section
    .uk-container
      h2.uk-heading-line
        span メンバーシッププラン

      - if flash[:notice].present?
        .uk-alert.uk-alert-success
          p = flash[:notice]

      - if flash[:error].present?
        .uk-alert.uk-alert-danger
          p = flash[:error]

      - if @membership_plans.empty?
        .uk-alert
          p 現在利用可能なプランはありません

      - else
        .uk-grid.uk-child-width-1-3@m.uk-grid-match data-uk-grid=""
          - @membership_plans.each do |plan|
            div
              .uk-card.uk-card-default.uk-card-hover
                .uk-card-header
                  h3.uk-card-title = plan.display_name.presence || plan.name
                  - plan.memberships.each do |membership|
                    span.uk-label.uk-margin-small-right = membership.display_name

                .uk-card-body
                  .uk-text-lead.uk-text-center
                    span.uk-text-bold style="font-size: 2rem"
                      = number_to_currency(plan.amount, unit: '¥', precision: 0)
                    span.uk-text-muted
                      = " / #{plan.recurring_interval_count}#{interval_unit_label(plan.recurring_interval_unit)}"

                  ul.uk-list.uk-list-bullet.uk-margin-top
                    - if plan.recurrence
                      li 自動更新あり
                    - else
                      li 一回払い
                    - plan.plan_payment_methods.each do |pm|
                      li = payment_method_label(pm.payment_type)

                .uk-card-footer
                  = link_to '詳細を見る', membership_plan_path(plan), class: 'uk-button uk-button-primary uk-width-1-1'

      .uk-margin-large-top.uk-text-center
        = link_to 'マイページに戻る', mypage_path, class: 'uk-button uk-button-default'

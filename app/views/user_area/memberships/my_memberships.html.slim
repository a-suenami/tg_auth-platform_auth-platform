.l-page
  .uk-section
    .uk-flex.uk-flex-center
      .uk-card.uk-card-default.uk-card-body class="uk-width-2-3@m"
        h3.uk-card-title 契約中のメンバーシップ

        - if flash[:notice].present?
          .uk-alert.uk-alert-success
            p = flash[:notice]

        - if flash[:error].present?
          .uk-alert.uk-alert-danger
            p = flash[:error]

        - if @contracts.empty?
          .uk-alert
            p 契約中のメンバーシップはありません
            .uk-margin-top
              = link_to 'プランを見る', membership_plans_path, class: 'uk-button uk-button-primary'

        - else
          - @contracts.each do |contract|
            .uk-card.uk-card-secondary.uk-card-body.uk-margin
              .uk-grid data-uk-grid=""
                .uk-width-2-3@m
                  h4 = contract.membership_plan&.display_name.presence || contract.membership_plan&.name || 'プラン'
                  p.uk-text-muted
                    | 契約日: #{contract.created_at.strftime('%Y年%m月%d日')}
                  - if contract.expires_at.present?
                    p.uk-text-muted
                      | 有効期限: #{contract.expires_at.strftime('%Y年%m月%d日')}

                .uk-width-1-3@m.uk-text-right
                  - case contract.status
                  - when 'active'
                    span.uk-label.uk-label-success 有効
                  - when 'pending'
                    span.uk-label.uk-label-warning 処理中
                  - when 'cancelled'
                    span.uk-label.uk-label-danger 解約済み
                  - when 'expired'
                    span.uk-label 期限切れ
                  - else
                    span.uk-label = contract.status

        .uk-margin-large-top
          .uk-grid.uk-child-width-1-2@s data-uk-grid=""
            div
              = link_to 'プラン一覧', membership_plans_path, class: 'uk-button uk-button-primary uk-width-1-1'
            div
              = link_to 'マイページに戻る', mypage_path, class: 'uk-button uk-button-default uk-width-1-1'

.l-page
  .uk-section
    .uk-flex.uk-flex-center
      .uk-card.uk-card-default.uk-card-body class="uk-width-2-3@m"
        h3.uk-card-title = @membership_plan.display_name.presence || @membership_plan.name

        - if flash[:error].present?
          .uk-alert.uk-alert-danger
            p = flash[:error]

        / プラン詳細
        .uk-margin
          h4 プラン内容
          table.uk-table.uk-table-striped
            tbody
              tr
                th.uk-width-1-3 料金
                td
                  = number_to_currency(@membership_plan.amount, unit: '¥', precision: 0)
                  span.uk-text-muted
                    = " / #{@membership_plan.recurring_interval_count}#{interval_unit_label(@membership_plan.recurring_interval_unit)}"
              tr
                th 更新
                td
                  - if @membership_plan.recurrence
                    | 自動更新あり
                  - else
                    | 一回払い
              tr
                th 含まれるメンバーシップ
                td
                  - @membership_plan.memberships.each do |membership|
                    span.uk-label.uk-margin-small-right = membership.display_name

        / 支払い方法選択
        .uk-margin-medium-top
          h4 支払い方法

          - available_methods = @membership_plan.plan_payment_methods.map(&:payment_type)

          = form_with url: purchase_membership_plan_path(@membership_plan), method: :post, local: true do |f|
            .uk-margin
              - if available_methods.include?('credit_card')
                label.uk-margin-small-right
                  = f.radio_button :payment_method, 'credit_card', checked: true, class: 'uk-radio'
                  |  クレジットカード
                  - if @has_card
                    span.uk-text-success.uk-margin-small-left （登録済み）
                  - else
                    span.uk-text-warning.uk-margin-small-left （未登録）

              - if available_methods.include?('konbini') || available_methods.include?('convenience')
                br
                label.uk-margin-small-right
                  = f.radio_button :payment_method, 'konbini', class: 'uk-radio'
                  |  コンビニ払い

            - unless @has_card
              .uk-alert.uk-alert-warning
                p
                  | クレジットカードが登録されていません。
                  = link_to 'カードを登録する', '#', class: 'uk-link'
                  |  か、別の支払い方法を選択してください。

            .uk-margin-medium-top
              = f.submit '購入する', class: 'uk-button uk-button-primary uk-button-large uk-width-1-1'

        .uk-margin-medium-top.uk-text-center
          = link_to 'プラン一覧に戻る', membership_plans_path, class: 'uk-button uk-button-default'

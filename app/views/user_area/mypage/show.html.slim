.ua-mypage-container
  / ヘッダー
  .ua-mypage-header
    h1.ua-mypage-title マイページ

  / メンバーシップカードセクション（テナントで設定されている場合）
  - if @membership_card_image.present?
    .ua-mypage-card-section
      .ua-membership-card style="background-image: url('#{@membership_card_image}')"
        .ua-membership-card__content
          .ua-membership-card__info
            | MEMBER ID: #{@user.id}
            br
            | MEMBER NAME: #{@user.user_profile&.full_name || @user.email}

      - if @membership_card_downloadable
        .uk-margin-top
          = link_to 'カードをダウンロード', '#', class: 'ua-btn ua-btn--sm ua-btn--secondary'

  / フラッシュメッセージ
  - if flash[:notice].present?
    .ua-mypage-content
      .ua-alert.ua-alert--success
        = flash[:notice]

  / メインコンテンツ
  .ua-mypage-content
    / アカウント情報セクション
    .ua-mypage-section
      h2.ua-section-heading アカウント情報

      table.ua-table
        tbody
          tr
            th メールアドレス
            td = @user.email
          tr
            th 電話番号
            td = @user.phone_number.presence || '未登録'
          tr
            th ステータス
            td
              - if @user.enabled?
                span.ua-badge.ua-badge--success 有効
              - else
                span.ua-badge.ua-badge--warning 未完了

    / プロフィール情報セクション
    - if @user.user_profile.present?
      .ua-mypage-section
        h2.ua-section-heading プロフィール

        table.ua-table
          tbody
            - if @user.user_profile.last_name.present? || @user.user_profile.first_name.present?
              tr
                th 氏名
                td = "#{@user.user_profile.last_name} #{@user.user_profile.first_name}"
            - if @user.user_profile.last_name_kana.present? || @user.user_profile.first_name_kana.present?
              tr
                th 氏名（カナ）
                td = "#{@user.user_profile.last_name_kana} #{@user.user_profile.first_name_kana}"
            - if @user.user_profile.birth_date.present?
              tr
                th 生年月日
                td = @user.user_profile.birth_date.strftime('%Y年%m月%d日')
            - if @user.user_profile.gender.present?
              tr
                th 性別
                td
                  - case @user.user_profile.gender
                  - when 'male'
                    | 男性
                  - when 'female'
                    | 女性
                  - when 'other'
                    | その他

    / 住所情報セクション
    - if @user.contact_address.present?
      .ua-mypage-section
        h2.ua-section-heading 住所

        table.ua-table
          tbody
            - if @user.contact_address.zip_code.present?
              tr
                th 郵便番号
                td = @user.contact_address.zip_code
            - if @user.contact_address.prefecture.present?
              tr
                th 都道府県
                td = @user.contact_address.prefecture.name
            - if @user.contact_address.city.present? || @user.contact_address.street.present?
              tr
                th 住所
                td = "#{@user.contact_address.city}#{@user.contact_address.street}"
            - if @user.contact_address.building.present?
              tr
                th 建物名
                td = @user.contact_address.building

    / メニューセクション
    .ua-mypage-section
      h2.ua-section-heading 設定・その他

      ul.ua-menu
        li.ua-menu__item
          = link_to edit_profile_path, class: 'ua-menu__link' do
            span プロフィールを編集
        li.ua-menu__item
          = link_to my_memberships_path, class: 'ua-menu__link' do
            span メンバーシップ
        li.ua-menu__item
          = link_to membership_plans_path, class: 'ua-menu__link' do
            span プラン一覧

    / ログアウトボタン
    .uk-text-center.uk-margin-large-top
      = link_to 'ログアウト', logout_path, class: 'ua-btn ua-btn--lg ua-btn--outline'

  / フッター
  footer.ua-footer
    .ua-footer__copyright
      | &copy; #{Time.current.year} All Rights Reserved.

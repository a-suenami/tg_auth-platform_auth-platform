.l-page
  .uk-section
    .uk-flex.uk-flex-center
      .uk-card.uk-card-default.uk-card-body class="uk-width-1-3@m"
        h3.uk-card-title SMS認証

        - if flash[:error].present?
          .uk-alert.uk-alert-danger
            p = flash[:error]

        - if flash[:notice].present?
          .uk-alert.uk-alert-success
            p = flash[:notice]

        p.uk-text-muted
          | SMSに送信された認証コードを入力してください。
          br
          | 送信先: #{@phone_number}

        = form_with url: sign_up_verify_sms_path, method: :post, local: true do |f|
          .uk-margin
            label.uk-form-label 認証コード
            .uk-form-controls
              = f.text_field :verification_code, class: 'uk-input', placeholder: '000000', required: true, autofocus: true, maxlength: 6, pattern: '[0-9]{6}'

          .uk-margin
            = f.submit '認証', class: 'uk-button uk-button-primary uk-width-1-1'

        .uk-margin-top.uk-text-center
          = button_to '認証コードを再送信', sign_up_resend_sms_path, method: :post, class: 'uk-button uk-button-text'

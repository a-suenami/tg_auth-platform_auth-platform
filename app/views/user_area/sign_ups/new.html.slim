.ua-auth-container
  .ua-auth-content
    .ua-auth-card
      / ヘッダー
      .ua-auth-header
        h1.ua-auth-title 新規登録

      / ボディ
      .ua-auth-body
        / フラッシュメッセージ
        - if flash[:error].present?
          .ua-alert.ua-alert--error.uk-margin-bottom
            = flash[:error]

        / 説明文
        .ua-auth-description
          | メールアドレスを入力してください。
          br
          | 認証コードをお送りします。

        / 新規登録フォーム
        = form_with url: sign_up_path, method: :post, local: true, class: 'ua-form' do |f|
          .ua-form__group
            label.ua-form__label メールアドレス
            = f.email_field :email, value: @email, class: 'ua-form__input', placeholder: 'example@example.com', required: true, autofocus: true

          .uk-margin-medium-top
            = f.submit '認証コードを送信', class: 'ua-btn ua-btn--lg ua-btn--primary'

        / ログインリンク
        .ua-auth-footer
          p.uk-margin-small-bottom すでにアカウントをお持ちの方
          = link_to 'ログインはこちら', login_path, class: 'ua-btn ua-btn--md ua-btn--secondary ua-btn--full-width'

  / フッター
  footer.ua-footer
    .ua-footer__copyright
      | &copy; #{Time.current.year} All Rights Reserved.

.l-page
  .uk-section
    .uk-flex.uk-flex-center
      .uk-card.uk-card-default.uk-card-body class="uk-width-1-3@m"
        h3.uk-card-title 新規登録

        - if flash[:error].present?
          .uk-alert.uk-alert-danger
            p = flash[:error]

        p.uk-text-muted メールアドレスを入力してください。認証コードをお送りします。

        = form_with url: sign_up_path, method: :post, local: true do |f|
          .uk-margin
            label.uk-form-label メールアドレス
            .uk-form-controls
              = f.email_field :email, value: @email, class: 'uk-input', placeholder: 'example@example.com', required: true, autofocus: true

          .uk-margin
            = f.submit '認証コードを送信', class: 'uk-button uk-button-primary uk-width-1-1'

        .uk-margin-top.uk-text-center
          = link_to 'ログインはこちら', login_path

.l-page
  .uk-section
    .uk-flex.uk-flex-center
      .uk-card.uk-card-default.uk-card-body class="uk-width-1-3@m"
        h3.uk-card-title 電話番号認証

        - if flash[:error].present?
          .uk-alert.uk-alert-danger
            p = flash[:error]

        p.uk-text-muted SMS認証のため、電話番号を入力してください。

        = form_with url: sign_up_phone_number_path, method: :post, local: true do |f|
          .uk-margin
            label.uk-form-label 電話番号
            .uk-form-controls
              = f.telephone_field :phone_number, class: 'uk-input', placeholder: '+81901234567', required: true, autofocus: true

          .uk-margin
            = f.submit '認証コードを送信', class: 'uk-button uk-button-primary uk-width-1-1'

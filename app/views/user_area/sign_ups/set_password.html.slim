.l-page
  .uk-section
    .uk-flex.uk-flex-center
      .uk-card.uk-card-default.uk-card-body class="uk-width-1-3@m"
        h3.uk-card-title パスワード設定

        - if flash[:error].present?
          .uk-alert.uk-alert-danger
            p = flash[:error]

        p.uk-text-muted パスワードを設定してください。

        = form_with url: sign_up_set_password_path, method: :post, local: true do |f|
          .uk-margin
            label.uk-form-label パスワード
            .uk-form-controls
              = f.password_field :password, class: 'uk-input', placeholder: 'パスワード', required: true, autofocus: true, minlength: 8

          .uk-margin
            label.uk-form-label パスワード（確認）
            .uk-form-controls
              = f.password_field :password_confirmation, class: 'uk-input', placeholder: 'パスワード（確認）', required: true, minlength: 8

          .uk-margin
            = f.submit '次へ', class: 'uk-button uk-button-primary uk-width-1-1'

.ua-auth-container
  .ua-auth-content
    .ua-auth-card
      / ヘッダー
      .ua-auth-header
        h1.ua-auth-title パスワード設定

      / ボディ
      .ua-auth-body
        / フラッシュメッセージ
        - if flash[:error].present?
          .ua-alert.ua-alert--error.uk-margin-bottom
            = flash[:error]

        / 説明文
        .ua-auth-description
          | パスワードを設定してください。

        / パスワードフォーム
        = form_with url: sign_up_set_password_path, method: :post, local: true, class: 'ua-form' do |f|
          .ua-form__group
            label.ua-form__label パスワード
            = f.password_field :password, class: 'ua-form__input', placeholder: 'パスワード', required: true, autofocus: true, minlength: 8
            p.ua-form__hint 8文字以上で入力してください

          .ua-form__group
            label.ua-form__label パスワード（確認）
            = f.password_field :password_confirmation, class: 'ua-form__input', placeholder: 'パスワード（確認）', required: true, minlength: 8

          .uk-margin-medium-top
            = f.submit '次へ', class: 'ua-btn ua-btn--lg ua-btn--primary'

  / フッター
  footer.ua-footer
    .ua-footer__copyright
      | &copy; #{Time.current.year} All Rights Reserved.

/ ログイン画面
h1 管理画面 ログインフォーム

/ ログインフォーム
= form_with url: admin_area_login_path, local: true, method: :post do |f|
  = f.label :email
  = f.email_field :email, class: 'uk-input'
  = f.label :password
  = f.password_field :password, class: 'uk-input'
  = f.submit 'ログイン', class: 'uk-button uk-button-primary'

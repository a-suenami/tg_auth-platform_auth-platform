/ AJAX-based tag assignment (no form submit)
.uk-margin-top.uk-container data-controller="user-tag-assignment-form" data-user-tag-assignment-form-base-url-value="#{admin_area_user_user_tag_assignments_path(@user)}"
  / Breadcrumb
  - breadcrumb_items = [{ text: 'ユーザー', link: admin_area_users_path }, { text: @user.email, link: admin_area_user_path(@user) }, { text: 'タグ編集' }]
  = render 'admin_area/shared/breadcrumb', items: breadcrumb_items

  .uk-card.uk-card-default.uk-card-body
    h2.uk-card-title = "#{@user.email} のユーザタグ編集"

    / Auto Tags Section (Read-only)
    - auto_tags = @available_tags.select { |t| @auto_tag_ids.include?(t.id) }
    - if auto_tags.any?
      .uk-margin
        label.uk-form-label.uk-text-bold
          | 自動タグ
          span.uk-text-meta.uk-text-small (削除できません)
        .uk-margin-small-top
          - auto_tags.each do |tag|
            span.uk-label.uk-label-success.uk-margin-small-right style="cursor: default;"
              = tag.name
              |  (auto)

    / Manual Tags Section (Editable via AJAX)
    .uk-margin
      label.uk-form-label.uk-text-bold 手動タグ

      / Selected manual tags displayed as chips
      .uk-margin-small-top data-user-tag-assignment-form-target="container" style="min-height: 40px; padding: 8px; border: 1px solid #e5e5e5; border-radius: 4px; background: #fafafa;"
        - if @manual_tag_ids.any?
          - manual_tags = @available_tags.select { |t| @manual_tag_ids.include?(t.id) }
          - manual_tags.each do |tag|
            span.uk-label.uk-margin-small-right.tag-chip data-tag-id=tag.id data-tag-name=tag.name data-action="click->user-tag-assignment-form#removeTag" style="cursor: pointer;"
              = tag.name
              |
              span uk-icon="icon: close; ratio: 0.8"
        - else
          span.uk-text-meta data-user-tag-assignment-form-target="placeholder" タグが選択されていません

      / Dropdown to add new tags
      .uk-margin-small-top
        label.uk-form-label.uk-text-small タグを追加
        select.uk-select data-user-tag-assignment-form-target="selector" data-action="change->user-tag-assignment-form#addTag"
          option value="" -- タグを選択 --
          - available_manual_tags = @available_tags.reject { |t| @auto_tag_ids.include?(t.id) || @manual_tag_ids.include?(t.id) }
          - available_manual_tags.each do |tag|
            option value=tag.id data-name=tag.name
              = tag.name

    .uk-margin-top
      = link_to '戻る', admin_area_user_path(@user), class: 'uk-button uk-button-default', data: { turbo_action: 'replace' }

  .uk-card.uk-card-default.uk-card-body.uk-margin-top
    h3.uk-card-title タグ履歴
    p.uk-text-meta 最新20件のタグ変更履歴を表示

    = render 'tag_history', user: @user

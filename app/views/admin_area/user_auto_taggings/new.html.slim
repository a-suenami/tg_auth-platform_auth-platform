= render 'admin_area/users/user_layout' do
  .p-user-auto-tagging-form data-controller="form-validation user-auto-tagging-form"
    .p-user-auto-tagging-form__breadcrumb
      = render 'admin_area/shared/breadcrumb', items: [{ text: 'オートタギング', link: admin_area_user_auto_taggings_path }, { text: '新規オートタギング' }]
    .l-page-content__content__main.p-user-auto-tagging-form__content__main
      = form_with model: @user_auto_tagging, url: admin_area_user_auto_taggings_path, method: :post, local: true, data: { turbo_frame: '_top', form_validation_target: 'form' }, html: { id: 'new_user_auto_tagging_form', 'data-initial-block-count': @user_auto_tagging.rule_blocks.size } do |f|
        = render 'admin_area/shared/form_error', target: f.object
        .c-form
          / 基本情報セクション
          .c-form-section
            .c-form-section__title 基本情報
            .c-form-field
              label.c-form-field__label オートタギング名
              = f.text_field :name, placeholder: 'オートタギング名を入力', class: 'c-form-field__input', required: true
            .c-form-field
              label.c-form-field__label 説明
              = f.text_area :description, placeholder: '説明文を入力', rows: 5, class: 'c-form-field__input'
            .c-form-field
              label.c-form-field__label style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
                .c-checkbox
                  = f.check_box :enabled, class: 'c-checkbox__input'
                  span.c-checkbox__checkbox
                span 有効にする
            .c-form-field
              label.c-form-field__label style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
                .c-checkbox
                  = f.check_box :shareable, class: 'c-checkbox__input'
                  span.c-checkbox__checkbox
                span 連携タグ設定

          / 条件セクション（大セクション）
          .c-form-section
            .c-form-section__title 条件
            .c-form-section__content
              / 一致した時に設定するタグ（小セクション）
              .c-form-section__sub-section
                .c-form-section__sub-section__title 一致した時に設定するタグ
                .c-form-field
                  .c-user-detail-tag__list data-tag-picker-selected=""
                    / 選択されたタグがここに表示されます（モック）
                    = link_to tag_picker_admin_area_user_auto_taggings_path, class: 'c-user-detail-tag__add', data: { turbo_frame: 'modal-frame' } do
                      = render 'shared/icons/icon-plus'
                      span.c-user-detail-tag__add__text タグを追加

              / 条件設定（小セクション）
              .c-form-section__sub-section
                .c-form-section__sub-section__title 条件設定
                .c-form-field__label__hint 条件ブロックはOR、ブロック内の条件はANDで評価されます
                .c-form-section__content
                  .c-condition-block__list data-user-auto-tagging-form-target="ruleBlocksContainer"
                    = f.fields_for :rule_blocks do |block_form|
                      = render 'admin_area/user_auto_taggings/rule_block_fields', f: block_form
                  .c-condition-block__add-block
                    button.c-form-section__add-block type="button" data-action="click->user-auto-tagging-form#addRuleBlock"
                      = render 'shared/icons/icon-plus'
                      span.c-form-section__add-block__text 条件ブロックを追加
                  template data-user-auto-tagging-form-target="ruleBlockTemplate"
                    = render 'admin_area/user_auto_taggings/rule_block_fields', f: nil, template: true
                  template data-user-auto-tagging-form-target="ruleTemplate"
                    = render 'admin_area/user_auto_taggings/rule_fields', f: nil, template: true

    .l-page-content__content__sub.p-user-auto-tagging-form__content__sub
      .p-user-auto-tagging-form__content__sub__section
        .p-user-auto-tagging-form__content__sub__button-wrapper
          button.p-user-auto-tagging-form__content__sub__button.p-user-auto-tagging-form__content__sub__button--submit type="submit" form="new_user_auto_tagging_form" data-form-validation-target="submit" disabled="disabled" 新規作成
          button.p-user-auto-tagging-form__content__sub__button__chevron type="button" data-dropdown-toggle="dropdown-save-actions"
            = render 'shared/icons/icon-chevron-down'
          .p-user-auto-tagging-form__content__sub__button__dropdown id="dropdown-save-actions"
            button.p-user-auto-tagging-form__content__sub__button__dropdown__item type="submit" form="new_user_auto_tagging_form" data-form-validation-target="submit" 新規作成
        = link_to admin_area_user_auto_taggings_path, class: 'p-user-auto-tagging-form__content__sub__button p-user-auto-tagging-form__content__sub__button--cancel', data: { turbo_frame: '_top' } do
          | キャンセル
      .p-user-auto-tagging-form__content__sub__section
        = link_to admin_area_users_path, class: 'p-user-auto-tagging-form__content__sub__button p-user-auto-tagging-form__content__sub__button--cancel', data: { turbo_frame: '_top' } do
          | ユーザー一覧

  / モーダル
  = render 'admin_area/shared/modal', modal_id: 'datepicker-modal'

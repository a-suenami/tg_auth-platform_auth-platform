.uk-margin-top.uk-container
  / Breadcrumb
  - breadcrumb_items = [{ text: 'ユーザー' }, { text: 'オートタギング' }]
  = render 'admin_area/shared/breadcrumb', items: breadcrumb_items

  .uk-flex.uk-flex-between.uk-flex-middle.uk-margin-bottom.uk-margin-top
    h2 オートタギング

  .uk-card.uk-card-default.uk-card-body.uk-margin-bottom
    .uk-flex.uk-flex-between.uk-flex-middle
      .uk-width-2-3
        = form_with url: admin_area_user_auto_taggings_path, method: :get, class: "uk-search uk-search-default uk-width-1-1" do |f|
          = f.text_field :q, placeholder: "ルール名を入力...", value: params[:q], class: "uk-search-input"
      .uk-width-1-3.uk-text-right
        = link_to new_admin_area_user_auto_tagging_path, class: "uk-button uk-button-primary" do
          span uk-icon="plus"
          |  新規作成

  .uk-card.uk-card-default.uk-card-body
    - if @user_auto_taggings.empty?
      p.uk-text-lead オートタグ設定が見つかりません
    - else
      table.uk-table.uk-table-divider.uk-table-hover
        thead
          tr
            th 名前
            th 作成者
        tbody
          - @user_auto_taggings.each do |rule|
            tr
              td
                = link_to rule.name, edit_admin_area_user_auto_tagging_path(rule.id)
              td
                = rule.created_by

    .uk-flex.uk-flex-between.uk-flex-middle.uk-margin-top
      .uk-text-small.uk-text-muted
        | #{@pagy.from}-#{@pagy.to} / #{@pagy.total_count}
      .uk-flex.uk-flex-middle
        button.uk-button.uk-button-default.uk-button-small disabled=(@pagy.prev.nil?)
          | < 前のページ
        button.uk-button.uk-button-default.uk-button-small.uk-margin-left disabled=(@pagy.next.nil?)
          | 次のページ >

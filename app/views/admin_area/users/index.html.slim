/ = form_tag admin_area_users_path, method: :get do
/   = text_field_tag :search, params[:search]
/   = submit_tag "Search"

.uk-margin-top.uk-container
  h2 会員ID一覧

  .uk-card.uk-card-default.uk-card-body
    p 検索条件
    = form_with url: admin_area_users_path, method: :get do |f|
      .uk-margin
        = f.label :id, "ID"
        = f.text_field :id, value: @id, class: "uk-input"
      .uk-margin
        = f.label :email, "メールアドレス"
        = f.text_field :email, value: @email, class: "uk-input"
      = submit_tag "Search", class: "uk-button uk-button-default"
    br

  .uk-margin-top.uk-card.uk-card-default.uk-card-body
    - if @users.empty?
      p.uk-text-lead
        | No users found
    - else
      table.uk-table.uk-table-divider
        tr
          th
            | ID
          th
            | メールアドレス
          th
            | 氏名
          th
            | 性別
          th
            | 年代
          th
            | 都道府県
          th
            | 操作
        - @users.each do |user|
          tr
            td
              = user.id
            td
              = user.email
            td
              = user&.user_profile&.name
            td
              = user&.user_profile&.gender
            td
              = user&.user_profile&.age_range
            td
              = user&.contact_address&.prefecture&.name
            td
              = link_to "詳細", admin_area_user_path(user), class: "uk-button uk-button-secondary"

    == pagy_nav(@pagy)

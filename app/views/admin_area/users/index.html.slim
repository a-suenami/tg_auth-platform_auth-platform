.uk-margin-top.uk-container
  h2 会員ID一覧

  .uk-card.uk-card-default.uk-card-body
    p 検索条件
    = form_with url: admin_area_users_path, method: :get do |f|
      .uk-margin
        = f.label :id, "ID"
        = f.text_field :id, placeholder: "539dde46-68a2-4619-9866-63b7478ae36e", value: params[:id], class: "uk-input"
      .uk-margin
        = f.label :email, "メールアドレス"
        = f.text_field :email, placeholder: "mail@example.com", value: params[:email], class: "uk-input"
      .uk-margin
        = f.label :phone_number, "電話番号"
        = f.text_field :phone_number, placeholder: "+818012345678 (国際電話番号フォーマット)", value: params[:phone_number], class: "uk-input"
      .uk-margin data-controller="user-search-tag-selector"
        = f.label :tag_ids, "タグ", class: "uk-form-label"
        - selected_tag_ids = Array(params[:tag_ids]).compact_blank
        - selected_tags = @user_tags.select { |t| selected_tag_ids.include?(t.id.to_s) }
        - available_tags = @user_tags.reject { |t| selected_tag_ids.include?(t.id.to_s) }

        / Selected tags displayed as chips
        .uk-margin-small-top data-user-search-tag-selector-target="container" data-action="click->user-search-tag-selector#removeTag" style="min-height: 40px; padding: 8px; border: 1px solid #e5e5e5; border-radius: 4px; background: #fafafa;"
          - if selected_tags.any?
            - selected_tags.each do |tag|
              span.uk-label.uk-label-primary.uk-margin-small-right.tag-chip data-tag-id=tag.id data-tag-name=tag.name style="cursor: pointer;"
                = tag.name
                |
                span uk-icon="icon: close; ratio: 0.8"
                = hidden_field_tag 'tag_ids[]', tag.id, id: "search_tag_#{tag.id}"
          - else
            span.uk-text-meta data-user-search-tag-selector-target="placeholder" タグが選択されていません

        / Dropdown to add new tags
        .uk-margin-small-top
          label.uk-form-label.uk-text-small タグを追加
          select.uk-select data-user-search-tag-selector-target="selector" data-action="change->user-search-tag-selector#addTag"
            option value="" -- タグを選択 --
            - available_tags.each do |tag|
              option value=tag.id data-name=tag.name
                = tag.name
      = submit_tag "Search", class: "uk-button uk-button-secondary"
      = link_to "検索初期化", admin_area_users_path, class: "uk-button uk-button-default uk-margin-left"
    br

  .uk-margin-top.uk-card.uk-card-default.uk-card-body
    - if @users.empty?
      p.uk-text-lead
        | No users found
    - else
      table.uk-table.uk-table-divider
        tr
          th
            | ID
          th
            | メールアドレス
          th
            | 氏名
          th
            | 性別
          th
            | 年代
          th
            | 都道府県
          th
            | 操作
        - @users.each do |user|
          tr
            td
              = user.id
            td
              = user.email
            td
              = user&.user_profile&.name
            td
              = user&.user_profile&.gender
            td
              - if user&.user_profile&.age_range.present?
                = user&.user_profile&.age_range
                | 代
              - else
                | -
            td
              = user&.contact_address&.prefecture&.name
            td
              = link_to "詳細", admin_area_user_path(user), class: "uk-button uk-button-secondary"

    == pagy_nav(@pagy)

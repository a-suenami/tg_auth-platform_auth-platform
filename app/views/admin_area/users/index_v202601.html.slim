= render 'admin_area/users/user_layout' do
  .l-page-content__content__main
    = render 'admin_area/shared/breadcrumb_v202601', items: [{ text: 'すべてのユーザー' }]
    .c-table-header
      .c-table-header__content
        a.c-table-header__content__filter href='#' data-filter-toggle="user-filter-section"
          = render 'shared/icons/icon-filter'
          span.c-table-header__content__filter__text 絞り込み
        .c-table-header__content__search
          input.c-table-header__content__search__input type='text' placeholder='検索'
          = render 'shared/icons/icon-search'
        = link_to new_admin_area_user_path, class: 'c-table-header__content__action', data: { turbo_frame: '_top' }
          = render 'shared/icons/icon-plus'
          span 会員新規登録
        a.c-table-header__content__more href='#'
          = render 'shared/icons/icon-more'
      - unless @users.empty?
        .c-table-header__pager
          - if @pagy.prev
            = link_to pagy_url_for(@pagy, @pagy.prev), class: 'c-table-header__pager__item'
              = render 'shared/icons/icon-chevron-left'
              span.c-table-header__pager__item__text 前へ
          - else
            span.c-table-header__pager__item.is-disabled
              = render 'shared/icons/icon-chevron-left'
              span.c-table-header__pager__item__text 前へ
          - if @pagy.next
            = link_to pagy_url_for(@pagy, @pagy.next), class: 'c-table-header__pager__item'
              span.c-table-header__pager__item__text 次へ
              = render 'shared/icons/icon-chevron-right'
          - else
            span.c-table-header__pager__item.is-disabled
              span.c-table-header__pager__item__text 次へ
              = render 'shared/icons/icon-chevron-right'
    - filter_active = params[:id].present? || params[:email].present? || params[:phone_number].present?
    .c-table-filter id="user-filter-section" data-filter-open="#{filter_active}"
      = form_with url: admin_area_users_path, method: :get, local: true, class: 'c-table-filter__form' do |f|
        .c-table-filter__fields
          .c-form-field
            = f.label :id, "ID", class: 'c-form-field__label'
            = f.text_field :id, placeholder: "539dde46-68a2-4619-9866-63b7478ae36e", value: params[:id], class: 'c-form-field__input'
          .c-form-field
            = f.label :email, "メールアドレス", class: 'c-form-field__label'
            = f.text_field :email, placeholder: "mail@example.com", value: params[:email], class: 'c-form-field__input'
          .c-form-field
            = f.label :phone_number, "電話番号", class: 'c-form-field__label'
            = f.text_field :phone_number, placeholder: "+818012345678 (国際電話番号フォーマット)", value: params[:phone_number], class: 'c-form-field__input'
        .c-table-filter__actions
          = f.submit "検索", class: 'c-table-filter__actions__button c-table-filter__actions__button--submit'
          = link_to "検索初期化", admin_area_users_path, class: 'c-table-filter__actions__button c-table-filter__actions__button--reset'
    - if @users.empty?
      .c-empty.c-empty--has-margin
        .c-empty__text ユーザーが見つかりません
    - else
      .c-table.has-checkbox.has-action
        table
          tr
            th
              label.c-checkbox
                input.c-checkbox__input type='checkbox'
                .c-checkbox__checkbox
            th
              | ID
            th
              | 氏名
            th
              | メールアドレス
            - unless Rails.env.production?
              th
                | 会員番号
              th
                | タグ
            th
              = render 'shared/icons/icon-config'
          - @users.each do |user|
            tr
              td
                label.c-checkbox
                  input.c-checkbox__input type='checkbox'
                  .c-checkbox__checkbox
              td.text-small
                = link_to admin_area_user_path(user), data: { turbo_frame: 'detail' } do
                  = user.id
              td
                = user&.user_profile&.name
              td
                = user.email
              - unless Rails.env.production?
                td 1234-5678-0000
                td
                  - if user.tag_assignments.any?
                    .c-tag-list
                      - user.tag_assignments.includes(:user_tag).first(5).each do |assignment|
                        - next unless assignment.user_tag
                        .c-tag.c-tag--primary
                          = assignment.user_tag.name
              td
                .c-table-row-action-wrapper
                  a.c-table-row-action href='#' data-dropdown-toggle="dropdown-user-#{user.id}"
                    = render 'shared/icons/icon-more-vertical'
                  .c-table-row-action__dropdown id="dropdown-user-#{user.id}"
                    = link_to admin_area_user_path(user), data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？', turbo_frame: '_top' }, class: 'c-table-row-action__dropdown__item'
                      | 削除
      .c-table-footer
        == pagy_nav(@pagy)

  = turbo_frame_tag "detail", class: "l-page-content__content__sub"

/ Header
.uk-margin-top
  h3 配信テンプレート

/ Main content area
.uk-margin-top style="border: 1px solid #e5e5e5; min-height: 500px; display: flex;"
  / Left sidebar - Template types
  .tg-template-types style="width: 250px; border-right: 1px solid #e5e5e5; background: #fafafa;"
    .tg-template-type.uk-padding-small.uk-active style="border-bottom: 1px solid #e5e5e5; font-weight: bold; cursor: pointer;"
      span uk-icon="mail"
      |  メールテンプレート
    .tg-template-type.uk-padding-small style="border-bottom: 1px solid #e5e5e5; color: #999; cursor: not-allowed;"
      span uk-icon="ban"
      |  Line FlexMessageテンプレート

  / Right content area
  .tg-template-content.uk-flex-1 style="position: relative; padding: 1rem;"
    - if @has_template_mail
      / Two-column layout inside content area
      .uk-grid.uk-grid-medium uk-grid=""
        / Left: Mail template info
        div class="uk-width-2-3@m"
          .uk-card.uk-card-default.uk-card-body
            h4 = @mail_template.title
            p.uk-text-small.uk-text-muted = @mail_template.body
          = render 'change_history'

        / Right: Metadata & History sidebar
        div class="uk-width-1-3@m"
          / Action dropdown
          .uk-margin-bottom
            = render 'action_dropdown'

          / Metadata card
          = render 'metadata'
    - else
      / Empty state with create button
      .uk-position-center.uk-margin
        = link_to edit_admin_area_template_mail_path(@template), class: 'uk-button uk-button-primary' do
          | メールテンプレートを新規作成する

/ Schedule Publish Modal
div#schedule-modal uk-modal=""
  .uk-modal-dialog
    button.uk-modal-close-default type="button" uk-close=""
    .uk-modal-header
      h2.uk-modal-title 公開設定
    .uk-modal-body
      = form_with url: schedule_admin_area_template_mail_path(@template), method: :post, local: true, data: { controller: 'schedule-form' } do |f|
        .uk-margin
          label.uk-form-label 公開予定日時
          .uk-form-controls
            / Only use existing time if it's in the future (scheduled), otherwise default to 1 hour from now
            - latest_time = @template.latest_version&.public_started_at
            - utc_value = (latest_time && latest_time > Time.current) ? latest_time.utc.iso8601 : ''
            = f.datetime_local_field :public_started_at, class: 'uk-input', required: true, data: { utc_value: utc_value, schedule_form_target: 'input' }
        .uk-margin
          = f.submit '変更を保存する', class: 'uk-button uk-button-primary uk-width-1-1'

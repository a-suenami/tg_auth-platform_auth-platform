/ Preview Tab Content
.uk-grid uk-grid=""
  / Sample Data Input Panel
  .uk-width-1-3
    .uk-card.uk-card-default.uk-card-body
      h4.uk-card-title
        span uk-icon="settings"
        |  サンプルデータ
      p.uk-text-small.uk-text-muted.uk-margin-small-bottom
        | プレビュー用のサンプルデータを入力してください

      - sample_defaults = AdminArea::TemplatesHelper::DEFAULT_SAMPLE_DATA
      = form_with url: preview_admin_area_template_mail_path(@template), method: :post, data: { template_preview_target: 'previewForm' }, id: 'preview-form' do |f|
        .uk-margin-small
          label.uk-form-label for="sample_first_name" 名前 (first_name)
          = f.text_field 'sample_data[first_name]', value: sample_defaults['first_name'], class: 'uk-input uk-form-small', id: 'sample_first_name'

        .uk-margin-small
          label.uk-form-label for="sample_last_name" 姓 (last_name)
          = f.text_field 'sample_data[last_name]', value: sample_defaults['last_name'], class: 'uk-input uk-form-small', id: 'sample_last_name'

        / Hidden field for current body (synced via Stimulus)
        = f.hidden_field :body, value: @mail_template&.body, data: { template_preview_target: 'previewBody' }
        = f.hidden_field :title, value: @mail_template&.title, data: { template_preview_target: 'previewTitle' }

        .uk-margin
          button.uk-button.uk-button-primary.uk-width-1-1 type="button" data-action="click->template-preview#submitPreviewForm" プレビュー更新

  / Preview Panel
  .uk-width-2-3
    .uk-background-muted.uk-padding style="min-height: 500px;"
      #preview-content
        = render 'admin_area/templates/mail/preview_content', mail_template: @mail_template, preview_result: @preview_result

= render 'admin_area/templates/mail/action_buttons'

= render 'admin_area/users/user_layout' do
  .p-user-tag-form data-controller="form-validation"
    .p-user-tag-form__breadcrumb
      = render 'admin_area/shared/breadcrumb_v202601', items: [{ text: 'すべてのタグ', link: admin_area_user_tags_path }, { text: @user_tag.name }]
    .l-page-content__content__main.p-user-tag-form__content__main
      = form_with model: @user_tag, url: admin_area_user_tag_path(@user_tag), method: :patch, local: true, data: { turbo_frame: '_top', form_validation_target: 'form' }, html: { id: 'edit_user_tag_form' } do |f|
        = render 'admin_area/shared/form_error', target: f.object
        .c-form
          .c-form-field
            label.c-form-field__label タグ名
            = f.text_field :name, placeholder: 'タグ名を入力', class: 'c-form-field__input', required: true
          .c-form-field
            label.c-form-field__label 説明
            = f.text_area :description, placeholder: '説明文を入力', rows: 5, class: 'c-form-field__input'
          .c-form-field
            label.c-form-field__label style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
              .c-checkbox
                = f.check_box :integration_enabled, class: 'c-checkbox__input'
                span.c-checkbox__checkbox
              span 連携タグ設定
            .c-form-field__hint 有効にすると、このタグは連携アプリに同期されます
    .l-page-content__content__sub.p-user-tag-form__content__sub
      .p-user-tag-form__content__sub__section
        .p-user-tag-form__content__sub__button-wrapper
          button.p-user-tag-form__content__sub__button.p-user-tag-form__content__sub__button--submit type="submit" form="edit_user_tag_form" data-form-validation-target="submit" 変更を保存
          button.p-user-tag-form__content__sub__button__chevron type="button" data-dropdown-toggle="dropdown-save-actions"
            = render 'shared/icons/icon-chevron-down'
          .p-user-tag-form__content__sub__button__dropdown id="dropdown-save-actions"
            button.p-user-tag-form__content__sub__button__dropdown__item type="submit" form="edit_user_tag_form" data-form-validation-target="submit" 変更を保存
            = link_to admin_area_user_tag_path(@user_tag), data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？', turbo_frame: '_top' }, class: 'p-user-tag-form__content__sub__button__dropdown__item' do
              | タグを削除
        = link_to admin_area_user_tags_path, class: 'p-user-tag-form__content__sub__button p-user-tag-form__content__sub__button--cancel', data: { turbo_frame: 'content' } do
          | キャンセル
      .p-user-tag-form__content__sub__section
        = link_to admin_area_users_path, class: 'p-user-tag-form__content__sub__button p-user-tag-form__content__sub__button--cancel', data: { turbo_frame: '_top' } do
          | ユーザー一覧
      .p-user-tag-form__content__sub__section.p-user-tag-form__content__sub__metadata
        .c-info
          .c-info__item
            .c-info__item__label 作成者
            .c-info__item__value = @user_tag.created_by_name || '-'
          .c-info__item
            .c-info__item__label 作成日時
            .c-info__item__value = local_time(@user_tag.created_at)
          .c-info__item
            .c-info__item__label 最終更新者
            .c-info__item__value = @user_tag.updated_by_name || '-'
          .c-info__item
            .c-info__item__label 最終更新日時
            .c-info__item__value = local_time(@user_tag.updated_at)
        - if @user_tag.user_auto_taggings.any?
          .c-info
            .c-info__item
              .c-info__item__label オートタギング設定
              .c-info__item__value
                ul
                  - @user_tag.user_auto_taggings.each do |auto_tagging|
                    li
                      = link_to auto_tagging.name, edit_admin_area_user_auto_tagging_path(auto_tagging), data: { turbo_frame: '_top' }
                      - status_label = auto_tagging.enabled? ? '有効' : '無効'
                      span.c-info__item__value__status = status_label

.uk-margin-top.uk-container
  / Breadcrumb
  - breadcrumb_items = [{ text: 'ユーザー' }, { text: 'タグ管理', link: admin_area_user_tags_path }, { text: @user_tag.name }]
  = render 'admin_area/shared/breadcrumb', items: breadcrumb_items

  .uk-grid data-uk-grid=""
    .uk-width-expand
      h2 = @user_tag.name

      .uk-margin-top.uk-card.uk-card-default.uk-card-body
        = form_with url: admin_area_user_tag_path(@user_tag.id), method: :patch, class: 'uk-form-stacked' do |f|
          .uk-margin
            = label_tag 'user_tag[name]', '名前', class: 'uk-form-label'
            .uk-form-controls
              = text_field_tag 'user_tag[name]', @user_tag.name, required: true, class: 'uk-input'

          .uk-margin
            = label_tag 'user_tag[description]', '説明', class: 'uk-form-label'
            .uk-form-controls
              = text_area_tag 'user_tag[description]', @user_tag.description, rows: 5, class: 'uk-textarea'

          .uk-margin
            = f.submit '保存する', class: 'uk-button uk-button-primary'

    .uk-width-1-3
      .uk-card.uk-card-default.uk-card-body.uk-margin-bottom
        = button_to '削除する', admin_area_user_tag_path(@user_tag.id), method: :delete, class: 'uk-button uk-button-danger uk-width-1-1', data: { turbo_confirm: '本当に削除しますか？' }
        = link_to '#', class: 'uk-button uk-button-primary uk-width-1-1 uk-margin-small-top' do
          | ユーザー一覧
          span.uk-margin-small-left uk-icon="chevron-right"
        
      .uk-card.uk-card-default.uk-card-body
        .uk-margin-small
          .uk-text-meta.uk-text-small 作成者
          .uk-text-bold = @user_tag.created_by_name

        .uk-margin-small
          .uk-text-meta.uk-text-small 作成日時
          div = @user_tag.created_at.strftime('%Y/%m/%d %H:%M')

        .uk-margin-small
          .uk-text-meta.uk-text-small 最終更新者
          .uk-text-bold = @user_tag.updated_by_name || '-'

        .uk-margin-small
          .uk-text-meta.uk-text-small 最終更新日時
          div = @user_tag.updated_at.strftime('%Y/%m/%d %H:%M')

      - if @user_tag.user_auto_taggings.any?
        .uk-card.uk-card-default.uk-card-body.uk-margin-top
          h4.uk-card-title オートタギング設定
          .uk-text-small.uk-text-muted.uk-margin-small-bottom
            | このタグは以下のルールで自動付与されます
          ul.uk-list.uk-list-divider
            - @user_tag.user_auto_taggings.each do |auto_tagging|
              li
                = link_to edit_admin_area_user_auto_tagging_path(auto_tagging) do
                  span = auto_tagging.name
                  - if auto_tagging.enabled?
                    span.uk-label.uk-label-success.uk-margin-small-left 有効
                  - else
                    span.uk-label.uk-margin-small-left 無効

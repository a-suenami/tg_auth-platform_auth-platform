# build userinfo by scopes
json = {}
profile_json = {}
contact_address_json = {}

json[:id] = current_user.id
json[:email] = current_user.email
json[:tel] = current_user.tel
json[:enabled] = current_user.enabled
json[:email_verified] = current_user.email_verified
profile_json[:first_name] = current_user.user_profile&.first_name
profile_json[:last_name] = current_user.user_profile&.last_name
profile_json[:first_name_kana] = current_user.user_profile&.first_name_kana
profile_json[:last_name_kana] = current_user.user_profile&.last_name_kana
profile_json[:birth_date] = current_user.user_profile&.birth_date
profile_json[:gender] = current_user.user_profile&.gender
contact_address_json[:prefecture_code] = current_user.contact_address&.prefecture_code
contact_address_json[:prefecture] = current_user.contact_address&.prefecture&.name
contact_address_json[:zip_code] = current_user.contact_address&.zip_code
contact_address_json[:city] = current_user.contact_address&.city
contact_address_json[:street] = current_user.contact_address&.street
contact_address_json[:building_name] = current_user.contact_address&.building_name
contact_address_json[:country_code] = current_user.contact_address&.country_code

json[:delivery_addresses] = current_user.delivery_addresses.map do |address|
  address_json = {}
  address_json[:is_default] = address&.is_default
  address_json[:prefecture_code] = address&.prefecture_code
  address_json[:prefecture] = address&.prefecture&.name
  address_json[:zip_code] = address&.zip_code
  address_json[:city] = address&.city
  address_json[:street] = address&.street
  address_json[:building_name] = address&.building_name
  address_json[:contact_tel] = address&.contact_tel
  address_json[:country_code] = address&.country_code
  address_json
end

json[:profile] = profile_json
json[:contact_address] = contact_address_json

json

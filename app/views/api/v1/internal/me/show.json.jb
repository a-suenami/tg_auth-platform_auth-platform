json = {}
profile_json = {}

json[:id] = current_user.id
json[:email] = current_user.email
json[:enabled] = current_user.enabled
json[:email_verified] = current_user.email_verified
json[:sms_verified] = current_user.sms_verified

profile_json[:first_name] = current_user.user_profile&.first_name
profile_json[:last_name] = current_user.user_profile&.last_name
profile_json[:first_name_kana] = current_user.user_profile&.first_name_kana
profile_json[:last_name_kana] = current_user.user_profile&.last_name_kana

json[:profile] = profile_json

json

/ ログイン画面
h1 Sample ログインフォーム

/ ログインフォーム
= form_with url: sessions_path, local: true do |f|
  = f.label :email
  = f.email_field :email, class: 'uk-input'
  = f.label :password
  = f.password_field :password, class: 'uk-input'
  = f.submit 'ログイン', class: 'uk-button uk-button-primary'

/ 新規登録link
= link_to '新規登録', new_registration_path

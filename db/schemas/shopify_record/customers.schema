create_table :shopify_record__customers, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }  do |t|
  t.references :tenant, type: :citext, null: false

  t.references :user, type: :uuid, null: false
  t.string :remote_id, null: false
  t.citext :email, null: false
  t.string :tags

  t.timestamps null: false

  t.index [:tenant_id, :email], name: 'idx_shopify_record__customers_tenant_id_email_uniq', unique: true
end

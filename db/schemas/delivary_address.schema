create_table :delivary_address, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false
  t.references  :user, type: :uuid, null: false
  t.boolean :is_default
  t.string :zip_code
  t.integer :prefecture_code
  t.string :city
  t.string :address1
  t.string :address2
  t.string :contact_tel

  t.timestamps null: false
end

add_foreign_key :delivary_address, :tenants, name: :fk_delivary_address_tenants
add_foreign_key :delivary_address, :users, name: :fk_delivary_address_users

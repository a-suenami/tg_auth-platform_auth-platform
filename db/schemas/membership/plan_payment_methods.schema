create_table :membership_plan_payment_methods, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'メンバーシッププランの支払い方法' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :membership_plan, type: :uuid, null: false
  t.string :payment_type, null: false, comment: '支払い方法: credit_card, convenience, campaign_code, external_linkage'
  t.boolean :is_active, default: true, comment: '有効フラグ'

  t.timestamps null: false
  t.index [:membership_plan_id, :payment_type], name: :idx_membership_plan_payment_methods_plan_type_uniq, using: :btree, unique: true
end

add_foreign_key :membership_plan_payment_methods, :membership_plans, column: :membership_plan_id, name: :fk_membership_plan_payment_methods_plans
add_foreign_key :membership_plan_payment_methods, :tenants, name: :fk_membership_plan_payment_methods_tenants

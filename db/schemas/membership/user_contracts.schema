create_table :memberships__user_contracts, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'ユーザーのメンバーシップ契約' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false
  t.datetime :expires_at, null: false, comment: '有効期限'
  t.boolean :cancel_at_period_end, default: false, comment: '次回更新時に解約フラグ'
  t.references :current_membership_plan, type: :uuid, null: false, comment: '現在のプラン'
  t.references :next_membership_plan, type: :uuid, comment: '次回変更予定プラン'
  t.references :current_membership_activation_source, type: :uuid, comment: '現在の決済情報'
  t.references :next_membership_activation_source, type: :uuid, comment: '次回変更予定の決済情報'

  t.timestamps null: false
  t.index [:tenant_id, :user_id], name: :idx_memberships__user_contracts_tenant_user, using: :btree
  t.index :expires_at, name: :idx_memberships__user_contracts_expires_at, using: :btree
end

add_foreign_key :memberships__user_contracts, :tenants, name: :fk_memberships__user_contracts_tenants
add_foreign_key :memberships__user_contracts, :users, name: :fk_memberships__user_contracts_users
add_foreign_key :memberships__user_contracts, :memberships__plans, column: :current_membership_plan_id, name: :fk_memberships__user_contracts_current_plans
add_foreign_key :memberships__user_contracts, :memberships__plans, column: :next_membership_plan_id, name: :fk_memberships__user_contracts_next_plans

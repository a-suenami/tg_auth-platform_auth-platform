create_table :membership_users, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'メンバーシップとUserの中間テーブル' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false

  t.timestamps null: false
  t.index [:tenant_id, :user_id], name: :idx_membership_users_tenant_id_user_id_uniq, using: :btree, unique: true
end

add_foreign_key :membership_users, :tenants, name: :fk_membership_users_tenants

create_table :membership_user_achievements, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'ユーザーのメンバーシップアチーブメント' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false
  t.references :membership, type: :uuid, null: false
  t.references :membership_plan, type: :uuid, null: false
  t.date :date, null: false, comment: '達成日'
  t.string :achievement_type, null: false, comment: 'アチーブメントタイプ'
  t.jsonb :achievement_data, default: {}, comment: 'アチーブメント詳細データ'

  t.timestamps null: false
  t.index [:tenant_id, :user_id, :membership_id, :date], name: :idx_membership_user_achievements_tenant_user_membership_date, using: :btree
  t.index :date, name: :idx_membership_user_achievements_date, using: :btree
end

add_foreign_key :membership_user_achievements, :tenants, name: :fk_membership_user_achievements_tenants
add_foreign_key :membership_user_achievements, :users, name: :fk_membership_user_achievements_users
add_foreign_key :membership_user_achievements, :memberships, column: :membership_id, name: :fk_membership_user_achievements_memberships
add_foreign_key :membership_user_achievements, :membership_plans, column: :membership_plan_id, name: :fk_membership_user_achievements_plans

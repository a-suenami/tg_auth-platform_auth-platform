create_table :memberships__activation_sources, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'メンバーシップの決済情報' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false
  t.references :membership_plan, type: :uuid, null: false
  t.references :memberships__user_contract, type: :uuid, null: false, comment: 'メンバーシップ契約ID'
  t.string :payment_type, null: false, comment: '支払い方法: credit_card, convenience, campaign_code, external_linkage'
  t.string :payment_provider, comment: '決済プロバイダ: stripe, komojuなど'
  t.string :external_id, comment: '外部システムのID'
  t.jsonb :payment_data, default: {}, comment: '決済詳細データ'
  t.datetime :activated_at, null: false, comment: '有効化日時'
  t.datetime :expires_at, null: false, comment: '有効期限'

  t.timestamps null: false
  t.index [:tenant_id, :user_id], name: :idx_memberships__activation_sources_tenant_user, using: :btree
  t.index :expires_at, name: :idx_memberships__activation_sources_expires_at, using: :btree
  t.index :external_id, name: :idx_memberships__activation_sources_external_id, using: :btree
end

add_foreign_key :memberships__activation_sources, :tenants, name: :fk_memberships__activation_sources_tenants
add_foreign_key :memberships__activation_sources, :users, name: :fk_memberships__activation_sources_users
add_foreign_key :memberships__activation_sources, :memberships__plans, column: :membership_plan_id, name: :fk_memberships__activation_sources_plans
add_foreign_key :memberships__activation_sources, :memberships__user_contracts, column: :memberships__user_contract_id, name: :fk_memberships__activation_sources_user_contracts

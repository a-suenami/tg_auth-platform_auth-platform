create_table :membership_plan_items, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: '販売プランとメンバーシップの中間テーブル' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :membership, type: :uuid, null: false
  t.references :plan, type: :uuid, null: false

  t.timestamps null: false
end

add_foreign_key :membership_plan_items, :tenants, name: :fk_membership_plan_items_tenants
add_foreign_key :membership_plan_items, :memberships, name: :fk_membership_plan_items_memberships
add_foreign_key :membership_plan_items, :membership_plans, name: :fk_membership_plan_items_membership_plansm, column: :plan_id

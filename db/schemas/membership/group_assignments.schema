create_table :memberships__group_assignments, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'メンバーシップとグループの中間テーブル' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :membership, type: :uuid, null: false
  t.references :membership_group, type: :uuid, null: false
  t.integer :position, default: 0, comment: '表示順序'

  t.timestamps null: false
  t.index [:membership_id, :membership_group_id], name: :idx_memberships__group_assignments_uniq, using: :btree, unique: true
  t.index [:membership_id, :position], name: :idx_memberships__group_assignments_membership_position, using: :btree
end

add_foreign_key :memberships__group_assignments, :tenants, name: :fk_memberships__group_assignments_tenants
add_foreign_key :memberships__group_assignments, :memberships, column: :membership_id, name: :fk_memberships__group_assignments_memberships
add_foreign_key :memberships__group_assignments, :memberships__groups, column: :membership_group_id, name: :fk_memberships__group_assignments_groups

create_table :users__sms_verifiers, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false
  t.string :code, null: false
  t.datetime :expired_at, null: false
  t.integer :remaining_attempts, default: 0
  t.string :verifier_type, null: false
  t.string :phone_number
  t.datetime :used_at
  t.string :sms_sender
  t.string :sms_sid
  t.string :ip_address
  t.string :delivery_type
  t.boolean :ignore_in_rate_limit, default: false, comment: 'SMS送信のレートリミットのカウントから除外する'

  t.timestamps null: false

  t.index [:created_at], name: :idx_users_created_at, using: :btree
  t.index [:phone_number], name: :idx_users_phone_number, using: :btree
  t.index [:ip_address], name: :idx_users_ip_address, using: :btree
end

add_foreign_key :users__sms_verifiers, :tenants, name: :fk_users__sms_verifiers_tenants
add_foreign_key :users__sms_verifiers, :users, name: :fk_users__sms_verifiers_users

create_table :delivery_activities, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'Delivery audit log' do |t|
  t.references :tenant, type: :citext, null: false, comment: 'Tenant reference'
  t.references :delivery, type: :uuid, null: false, comment: 'Delivery reference'
  t.references :admin, type: :uuid, comment: 'Admin who performed action'

  # Action: created | updated | published | cancelled | paused | resumed | sent
  t.string :action, null: false, comment: 'Action type'
  t.jsonb :metadata, default: {}, comment: 'What changed (JSON)'
  t.text :note, comment: 'Optional note'

  t.timestamps null: false

  t.index [:delivery_id, :created_at], name: 'idx_delivery_activities_timeline'
  t.index [:tenant_id, :delivery_id]
end

add_foreign_key :delivery_activities, :tenants
add_foreign_key :delivery_activities, :deliveries
add_foreign_key :delivery_activities, :admins

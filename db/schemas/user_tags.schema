create_table :user_tags, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'User tags for manual tagging' do |t|
  t.references :tenant, type: :citext, null: false, comment: 'Tenant reference'
  t.string :name, null: false, comment: 'Tag name'
  t.text :description, comment: 'Tag description'
  t.references :created_by, type: :uuid, comment: 'Admin who created this tag'
  t.references :updated_by, type: :uuid, comment: 'Admin who last updated this tag'
  t.boolean :integration_enabled, default: false, null: false, comment: 'Enable tag sync to integrated apps (連携タグ設定)'

  t.timestamps null: false

  t.index [:tenant_id, :name], unique: true
end

add_foreign_key :user_tags, :tenants
add_foreign_key :user_tags, :admins, column: :created_by_id
add_foreign_key :user_tags, :admins, column: :updated_by_id

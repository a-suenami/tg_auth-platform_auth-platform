create_table :delivery_executions, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'Per-user delivery tracking' do |t|
  t.references :tenant, type: :citext, null: false, comment: 'Tenant reference'
  t.references :delivery, type: :uuid, null: false, comment: 'Delivery reference'
  t.references :user, type: :uuid, null: false, comment: 'Target user'

  # Status: pending | sent | failed | skipped
  t.string :status, null: false, default: 'pending', comment: 'Execution status'
  t.datetime :scheduled_for, comment: 'When this execution is scheduled'
  t.datetime :sent_at, comment: 'When email was actually sent'
  t.text :error_message, comment: 'Error message if failed'

  t.timestamps null: false

  t.index [:delivery_id, :user_id], unique: true, name: 'idx_delivery_executions_unique'
  t.index [:tenant_id, :delivery_id]
  t.index [:status, :scheduled_for], name: 'idx_delivery_executions_pending'
end

add_foreign_key :delivery_executions, :tenants
add_foreign_key :delivery_executions, :deliveries
add_foreign_key :delivery_executions, :users

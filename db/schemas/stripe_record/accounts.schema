# ==============================================================================
# db/schemas/stripe_record/accounts.schema
# ==============================================================================
create_table :stripe_record_accounts, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.string :remote_id, null: false, comment: 'Stripe のアカウント ID' # controlling_platform_id との組み合わせで unique

  t.references :api_key,              type: :uuid, null: true, foreign_key: {
    to_table: :stripe_record_api_keys, column: :api_key_id, name: :fk_stripe_record_accounts_api_key_id,
  }
  t.references :controlling_platform, type: :uuid, null: true, foreign_key: {
    to_table: :stripe_record_accounts, column: :controlling_platform_id, name: :fk_stripe_record_accounts_controlling_platform_id,
  }

  t.string :type
  t.string :business_profile_name
  t.string :payments_statement_descriptor
  t.string :payments_statement_descriptor_kana
  t.string :payments_statement_descriptor_kanji
  t.string :display_name,                        null: false, comment: 'API キーがどのアカウントのものかを識別するための名前'

  t.timestamps null: false

  t.index [:remote_id, :controlling_platform_id], name: :index_stripe_record_accounts_remote_id_unique, using: :btree, unique: true, nulls_not_distinct: true
end

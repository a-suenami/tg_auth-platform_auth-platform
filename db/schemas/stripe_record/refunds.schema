# ==============================================================================
# db/schemas/stripe_record/refunds.schema
# ==============================================================================
create_table :stripe_record_refunds, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false, index: true, foreign_key: { name: :fk_stripe_record_payment_intents__tenants }

  t.string :remote_id, null: false, index: { unique: true, name: 'idx_stripe_record_refund_remote_id_uniq' }, comment: 'Stripe の refund ID'

  t.references :user,           type: :uuid, null: false, index: true, foreign_key: { name: :fk_stripe_record_refunds__users }
  t.references :payment_intent, type: :uuid, null: false, index: true, foreign_key: {
    to_table: :stripe_record_payment_intents, column: :payment_intent_id, name: :fk_stripe_record_refunds_payment_intent_id,
  }

  t.integer :amount
  t.string  :balance_transaction_id
  # t.string  :charge
  t.string  :currency
  t.jsonb   :destination_details
  t.jsonb   :metadata
  # t.string  :payment_intent
  t.string  :reason
  t.string  :receipt_number
  t.string  :source_transfer_reversal_id
  t.string  :status
  t.string  :transfer_reversal_id
  # Timestamps
  t.timestamps
  t.integer :created

  # 以下は Slash Gift 側での管理用
  t.references :api_key_account, type: :uuid, null: false, index: true, foreign_key: {
    to_table: :stripe_record_accounts, column: :api_key_account_id, name: :fk_stripe_record_refunds_api_key_account_id,
  }, comment: 'API Key を持っているアカウント。通常の決済であればその決済のアカウントとなる。Connect の場合はプラットフォームアカウントになる。'
  t.references :connect_account, type: :uuid, null: true, index: true, foreign_key: {
    to_table: :stripe_record_accounts, column: :connect_account_id, name: :fk_stripe_record_refunds_connect_account_id,
  }, comment: 'Connect のときだけ使用する。この決済がどの Connected アカウントに対する支払いなのかを表す。'
  t.string :charge_type, comment: 'Connect のときだけ使用する。どの支払いタイプなのかを表す'
end

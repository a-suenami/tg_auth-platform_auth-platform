# ==============================================================================
# db/schemas/stripe_record/payment_methods.schema
# ==============================================================================
create_table :stripe_record__payment_methods, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false, index: true, foreign_key: { name: :fk_stripe_record_payment_methods__tenants }

  t.string :remote_id, null: false, index: { unique: true, name: 'idx_stripe_record_payment_methods_remote_id_uniq' }, comment: 'Stripe の payment method ID'

  t.references :user,         type: :uuid, null: false, index: true, foreign_key: { name: :fk_stripe_record_payment_methods__users }
  t.references :setup_intent, type: :uuid, null: true,  index: true, foreign_key: {
    name: :fk_stripe_record_payment_methods__setup_intents, to_table: :stripe_record__setup_intents, column: :setup_intent_id,
  }

  t.string :type,            null: false,              comment: 'payment method の種類。card など'
  t.jsonb  :billing_details, null: true,  default: {}, comment: '請求先情報'
  t.jsonb  :card,            null: true,  default: {}, comment: 'card の詳細情報'
  t.string :customer_id,     null: false,              comment: 'この PaymentMethod の持ち主の customer ID'

  t.datetime :detached_at, null: true, comment: 'detach された日時'

  t.timestamps null: false

  # 以下は Slash Gift 側での管理用
  t.references :api_key_account, type: :uuid, null: false, index: true, foreign_key: {
    to_table: :stripe_record__accounts, column: :api_key_account_id, name: :fk_stripe_record_payment_methods_api_key_account_id,
  }, comment: 'API Key を持っているアカウント。通常の決済であればその決済のアカウントとなる。Connect の場合はプラットフォームアカウントになる。'
  t.references :connect_account, type: :uuid, null: true, index: true, foreign_key: {
    to_table: :stripe_record__accounts, column: :connect_account_id, name: :fk_stripe_record_payment_methods_connect_account_id,
  }, comment: 'Connect のときだけ使用する。この決済がどの Connected アカウントに対する支払いなのかを表す。'
  t.string :charge_type, comment: 'Connect のときだけ使用する。どの支払いタイプなのかを表す'
end

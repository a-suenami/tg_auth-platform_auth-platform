create_table :payment__subscriptions, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: '支払い取引情報' do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false
  t.references :membership_contract, type: :uuid, null: false, comment: 'メンバーシップ契約ID'

  # 決済情報
  t.references :subscribable, type: :uuid,   polymorphic: true, comment: 'サブスクリプションオブジェクト'

  t.timestamps null: false
  t.index [:tenant_id, :user_id], name: :idx_payment__subscriptions_tenant_user, using: :btree
end

add_foreign_key :payment__subscriptions, :tenants, name: :fk_payment__subscriptions_tenants
add_foreign_key :payment__subscriptions, :users, name: :fk_payment__transactions_users
add_foreign_key :payment__subscriptions, :memberships__contracts, column: :membership_contract_id, name: :fk_payment__transactions_contracts

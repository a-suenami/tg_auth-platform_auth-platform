create_table :delivery_schedules, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'Datetime-based delivery schedules' do |t|
  t.references :tenant, type: :citext, null: false, comment: 'Tenant reference'
  t.references :delivery, type: :uuid, null: false, comment: 'Parent delivery'

  # Status: draft | scheduled | delivering | delivered | cancelled
  t.string :status, null: false, default: 'draft', comment: 'Schedule status'
  t.datetime :scheduled_at, comment: 'Scheduled delivery datetime'

  # Publish tracking
  t.datetime :published_at, comment: 'When schedule was published'
  t.references :published_by, type: :uuid, comment: 'Admin who published'

  t.timestamps null: false

  t.index [:delivery_id], unique: true, name: 'idx_delivery_schedules_delivery_unique'
  t.index [:tenant_id, :status]
  t.index [:status, :scheduled_at], name: 'idx_delivery_schedules_pending'
end

add_foreign_key :delivery_schedules, :tenants
add_foreign_key :delivery_schedules, :deliveries
add_foreign_key :delivery_schedules, :admins, column: :published_by_id

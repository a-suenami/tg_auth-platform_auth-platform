create_table :delivery_addresses, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false
  t.references :user, type: :uuid, null: false
  t.boolean :is_default
  t.string :zip_code
  t.integer :prefecture_code
  t.string :city
  t.string :street
  t.string :building
  t.string :phone_number
  t.string :country_code

  t.timestamps null: false
end

add_foreign_key :delivery_addresses, :tenants, name: :fk_delivery_addresses_tenants
add_foreign_key :delivery_addresses, :users, name: :fk_delivery_addresses_users

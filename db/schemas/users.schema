create_table :users, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false
  t.string  :email
  t.string  :password_digest
  t.boolean :enabled, default: false
  # TODO: 電話番号はphone_number+phone_country_codeにするのでtelは移行済み次第消す
  t.string  :tel
  t.string :phone_number
  t.string :phone_country_code
  t.boolean :sms_verified, default: false
  t.boolean :email_verified, default: false
  t.boolean :deleted, default: false
  t.string  :password_reset_code

  # アカウントロック
  t.integer  :failed_attempts, null: false, default: 0
  t.string   :unlock_token
  t.datetime :lock_expired_at

  t.timestamps null: false
  t.index [:tenant_id, :email, :deleted], name: :index_users_on_tenant_id_email, using: :btree, unique: true, where: '("deleted" = false)'
end

add_foreign_key :users, :tenants, name: :fk_users_tenants

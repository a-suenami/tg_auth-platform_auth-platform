create_table :users, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' } do |t|
  t.references :tenant, type: :citext, null: false
  t.string  :email
  t.string  :password_digest
  t.boolean :enabled, default: false
  t.string :phone_number
  t.boolean :sms_verified, default: false
  t.boolean :email_verified, default: false
  t.boolean :suppress_sms_verification, default: false
  t.boolean :deleted, default: false
  t.datetime :deleted_at, default: nil
  t.string :password_reset_code

  # Recaptcha の評価スコア
  t.float 'captcha_score'

  # Payment
  t.string  :payment_provider
  t.string  :payment_customer_id
  t.string  :default_payment_method

  t.timestamps null: false
  t.index [:tenant_id, :email], name: :index_users_on_tenant_id_email, using: :btree, unique: true, where: '(deleted_at IS NULL)'
  t.index [:tenant_id, :phone_number], name: :index_users_on_tenant_id_phone_number, using: :btree, unique: true, where: '(deleted_at IS NULL)'
  t.index [:tenant_id, :id], name: :index_users_on_tenant_id_and_id, unique: true
end

add_foreign_key :users, :tenants, name: :fk_users_tenants

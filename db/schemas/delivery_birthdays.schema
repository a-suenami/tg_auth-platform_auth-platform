create_table :delivery_birthdays, force: :cascade, id: :uuid, default: -> { 'gen_random_uuid()' }, comment: 'Birthday-based delivery schedules' do |t|
  t.references :tenant, type: :citext, null: false, comment: 'Tenant reference'
  t.references :delivery, type: :uuid, null: false, comment: 'Parent delivery'

  # Status: draft | ongoing | delivering | paused
  t.string :status, null: false, default: 'draft', comment: 'Birthday delivery status'
  t.integer :offset_days, null: false, default: 0, comment: 'Days offset from birthday (negative = before)'
  t.string :delivery_time, null: false, default: '09:00', comment: 'Delivery time HH:MM'

  # Publish tracking
  t.datetime :published_at, comment: 'When birthday delivery was activated'
  t.references :published_by, type: :uuid, comment: 'Admin who activated'

  # Blastengine Bulk API (daily tracking - reset each day)
  t.bigint :blastengine_delivery_id, comment: 'Current day Blastengine bulk delivery ID'
  t.string :blastengine_job_id, comment: 'Current day CSV import job ID'
  t.date :last_setup_date, comment: 'Which date setup was done for'
  t.datetime :setup_completed_at, comment: 'When bulk setup completed for current day'

  t.timestamps null: false

  t.index [:delivery_id], unique: true, name: 'idx_delivery_birthdays_delivery_unique'
  t.index [:tenant_id, :status]
  t.index [:blastengine_delivery_id], name: 'idx_delivery_birthdays_blastengine'
end

add_foreign_key :delivery_birthdays, :tenants
add_foreign_key :delivery_birthdays, :deliveries
add_foreign_key :delivery_birthdays, :admins, column: :published_by_id
